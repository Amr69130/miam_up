{% extends 'base.html.twig' %}

{% block title %}Mon Profil – Miam_Up{% endblock %}

{% block body %}
<div class="flex min-h-screen bg-[#F8F8F8]">

  {# La fameuse sidebar #}
  {% include 'pannel_resto/_sidebar.html.twig' with { active: 'profil' } %}

  <div class="ml-16 flex-1 flex flex-col min-h-screen">

    <div class="bg-white border-b border-gray-200 px-6 py-4 flex items-center justify-between">
      <div class="flex items-center gap-3">
        <div class="w-12 h-12 rounded-full bg-[#00A9A5] text-white flex items-center justify-center font-bold text-lg">
          {{ user.prenomUtilisateur|first|upper }}{{ user.nomUtilisateur|first|upper }}
        </div>
        <div>
          <h1 class="font-bold text-[#4A4A4A] text-lg leading-tight">{{ user.prenomUtilisateur }} {{ user.nomUtilisateur }}</h1>
          <p class="text-sm text-gray-500">Gestion de mon compte</p>
        </div>
      </div>
    </div>

    <main class="p-6 max-w-5xl pb-16">

      <div class="mb-6">
        <h2 class="text-xl font-bold text-[#4A4A4A]">Mes Informations Personnelles</h2>
        <p class="text-sm text-gray-500 mt-1">
          Consultez et modifiez les détails de votre compte <span class="text-[#00A9A5]">Miam_Up</span>.
        </p>
      </div>

      {# Grille de 2 colonnes pour les informations #}
      <div class="grid grid-cols-1 md:grid-cols-2 gap-4 mb-4">

        {# Prénom #}
        <div class="bg-white rounded-xl border border-gray-200 p-4">
          <div class="flex items-center justify-between mb-2">
            <div class="flex items-center gap-1.5 text-xs font-semibold text-gray-400 uppercase tracking-wide">
              Prénom
            </div>
            {# Note: Le premier argument 'prenom' correspond au 'case' dans ton Controller #}
            <button type="button" onclick="openEditModal('prenom', 'Prénom', '{{ user.prenomUtilisateur|e('js') }}')"
                    class="flex items-center gap-1 text-xs text-[#00A9A5] hover:underline">
              <svg xmlns="http://www.w3.org/2000/svg" class="w-3 h-3" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M15.232 5.232l3.536 3.536M9 13l6.586-6.586a2 2 0 112.828 2.828L11.828 15.828a2 2 0 01-1.414.586H9v-1.414A2 2 0 019.586 13z"/></svg>
              Modifier
            </button>
          </div>
          <p class="text-[#4A4A4A] text-sm font-medium">{{ user.prenomUtilisateur }}</p>
        </div>

        {# Nom #}
        <div class="bg-white rounded-xl border border-gray-200 p-4">
          <div class="flex items-center justify-between mb-2">
            <div class="flex items-center gap-1.5 text-xs font-semibold text-gray-400 uppercase tracking-wide">
              Nom
            </div>
            <button type="button" onclick="openEditModal('nom', 'Nom', '{{ user.nomUtilisateur|e('js') }}')"
                    class="flex items-center gap-1 text-xs text-[#00A9A5] hover:underline">
              <svg xmlns="http://www.w3.org/2000/svg" class="w-3 h-3" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M15.232 5.232l3.536 3.536M9 13l6.586-6.586a2 2 0 112.828 2.828L11.828 15.828a2 2 0 01-1.414.586H9v-1.414A2 2 0 019.586 13z"/></svg>
              Modifier
            </button>
          </div>
          <p class="text-[#4A4A4A] text-sm font-medium">{{ user.nomUtilisateur }}</p>
        </div>

        {# Email #}
        <div class="bg-white rounded-xl border border-gray-200 p-4">
          <div class="flex items-center justify-between mb-2">
            <div class="flex items-center gap-1.5 text-xs font-semibold text-gray-400 uppercase tracking-wide">
              Adresse Email
            </div>
            <button type="button" onclick="openEditModal('email', 'Adresse Email', '{{ user.emailUtilisateur|e('js') }}')"
                    class="flex items-center gap-1 text-xs text-[#00A9A5] hover:underline">
              <svg xmlns="http://www.w3.org/2000/svg" class="w-3 h-3" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M15.232 5.232l3.536 3.536M9 13l6.586-6.586a2 2 0 112.828 2.828L11.828 15.828a2 2 0 01-1.414.586H9v-1.414A2 2 0 019.586 13z"/></svg>
              Modifier
            </button>
          </div>
          <p class="text-[#4A4A4A] text-sm font-medium">{{ user.emailUtilisateur }}</p>
        </div>

        {# Rôle / Statut #}
        <div class="bg-white rounded-xl border border-gray-200 p-4 bg-gray-50">
          <div class="flex items-center gap-1.5 text-xs font-semibold text-gray-400 uppercase tracking-wide mb-2">
            Type de compte
          </div>
          <p class="text-[#4A4A4A] text-sm font-medium">
            {% if 'ROLE_RESTAURATEUR' in user.roles %}
              Restaurateur 🍳
            {% else %}
              Consommateur 🍕
            {% endif %}
          </p>
        </div>

      </div>

    </main>
  </div>
</div>

{# ===== MODALE — Modifier un champ texte ===== #}
<div id="modal-profile-edit" class="hidden fixed inset-0 z-50 flex items-center justify-center bg-black/40 px-4">
  <div class="bg-white rounded-2xl shadow-2xl w-full max-w-md">
    <div class="flex items-center justify-between px-6 pt-6 pb-4 border-b border-gray-100">
      <h3 id="modal-edit-title" class="font-bold text-[#4A4A4A] text-lg">Modifier</h3>
      <button type="button" onclick="closeEditModal()" class="w-8 h-8 flex items-center justify-center rounded-xl hover:bg-gray-100">
        <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-gray-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"/></svg>
      </button>
    </div>
    <form method="POST" action="{{ path('app_profil_update') }}" class="px-6 py-5">
      <input type="hidden" id="edit-field-key" name="field">
      <div class="mb-4">
        <label id="modal-edit-label" class="block text-xs font-semibold text-gray-500 uppercase tracking-wide mb-1.5"></label>
        <input id="edit-field-input" name="value" type="text" required
               class="w-full border border-gray-200 focus:border-[#00A9A5] rounded-xl px-4 py-2.5 text-sm text-[#4A4A4A] outline-none transition-colors">
      </div>
      <div class="flex items-center justify-end gap-3 pt-2 border-t border-gray-100">
        <button type="button" onclick="closeEditModal()"
                class="px-4 py-2 text-sm font-medium text-[#4A4A4A] border border-gray-200 rounded-xl hover:bg-gray-50">Annuler</button>
        <button type="submit"
                class="flex items-center gap-2 px-5 py-2 text-sm font-semibold text-white bg-[#00A9A5] hover:bg-[#008b87] rounded-xl shadow-sm">
          Enregistrer
        </button>
      </div>
    </form>
  </div>
</div>

<script>
function openEditModal(key, label, value) {
  document.getElementById('edit-field-key').value = key;
  document.getElementById('modal-edit-title').textContent = 'Modifier : ' + label;
  document.getElementById('modal-edit-label').textContent = label;
  document.getElementById('edit-field-input').value = value;
  document.getElementById('modal-profile-edit').classList.remove('hidden');
}
function closeEditModal() {
  document.getElementById('modal-profile-edit').classList.add('hidden');
}
document.getElementById('modal-profile-edit').addEventListener('click', function(e) { 
  if (e.target === this) closeEditModal(); 
});
</script>
{% endblock %}