<nav class="w-16 bg-white border-r border-[#e5e7eb] flex flex-col items-center py-4 gap-1 flex-shrink-0 h-screen sticky top-0">

    {# Logo #}
    <div class="w-10 h-10 bg-[#00A9A5] rounded-[14px] flex items-center justify-center mb-6">
        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="m16 2-2.3 2.3a3 3 0 0 0 0 4.2l1.8 1.8a3 3 0 0 0 4.2 0L22 8"/>
            <path d="M15 15 3.3 3.3a4.2 4.2 0 0 0 0 6l7.3 7.3c.7.7 2 .7 2.8 0L15 15Zm0 0 5.7 5.7"/>
            <path d="M2.1 21.8 6.4 17.5"/>
        </svg>
    </div>

    {% set current = app.request.pathInfo %}

    {% set nav_items = [
        {
            active: current == '/',
            label: 'Accueil',
            route: 'app_home',
            icon: '<path d="m3 9 9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/>'
        },
        {
            active: current starts with '/carte',
            label: 'Carte',
            route: 'app_map',
            icon: '<polygon points="3 6 9 3 15 6 21 3 21 18 15 21 9 18 3 21"/><line x1="9" x2="9" y1="3" y2="18"/><line x1="15" x2="15" y1="6" y2="21"/>'
        },
        {
            active: current starts with '/restaurant',
            label: 'Restos',
            route: 'restaurant_list',
            icon: '<path d="M3 2v7c0 1.1.9 2 2 2h4a2 2 0 0 0 2-2V2"/><path d="M7 2v20"/><path d="M21 15V2a5 5 0 0 0-5 5v6c0 1.1.9 2 2 2h3Zm0 0v7"/>'
        }
    ] %}

    {% for item in nav_items %}
        <a href="{{ path(item.route) }}"
           title="{{ item.label }}"
           class="w-12 h-12 rounded-[14px] flex flex-col items-center justify-center gap-0.5 transition-colors {{ item.active ? 'bg-[#84DCCF]/15 text-[#00A9A5]' : 'text-[#99A1AF] hover:text-[#4A4A4A] hover:bg-gray-50' }}">
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                {{ item.icon|raw }}
            </svg>
            <span class="text-[9px] leading-[13.5px]">{{ item.label }}</span>
        </a>
    {% endfor %}

    {# Spacer #}
    <div class="flex-1"></div>

    {# Déconnexion #}
    {% if app.user %}
        <a href="{{ path('app_logout') }}"
           title="Déconnexion"
           class="w-12 h-12 rounded-[14px] flex flex-col items-center justify-center gap-0.5 text-[#99A1AF] hover:text-red-500 hover:bg-red-50 transition-colors">
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/>
                <polyline points="16 17 21 12 16 7"/>
                <line x1="21" x2="9" y1="12" y2="12"/>
            </svg>
            <span class="text-[9px] leading-[13.5px]">Quitter</span>
        </a>
    {% endif %}

</nav>
