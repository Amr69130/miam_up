{% extends 'base.html.twig' %}

{% block title %}Messages - {{ ami_selectionne.prenomUtilisateur }} | Miam Up{% endblock %}

{% block body %}
<div class="flex h-screen overflow-hidden bg-[#F8F8F8] font-['Inter',sans-serif]">

    {% include 'partials/_sidebar.html.twig' with { active: 'messages' } %}

    <div class="flex-1 flex overflow-hidden">

        {# ── Sidebar amis ── #}
        <div class="w-64 bg-white border-r border-gray-100 flex flex-col flex-shrink-0">
            <div class="p-4 border-b border-gray-100">
                <h2 class="font-bold text-[#4A4A4A] text-sm">Conversations</h2>
            </div>
            <div class="flex-1 overflow-y-auto py-2">
                {% for ami in liste_amis %}
                    <a href="{{ path('app_messenger_chat', {id: ami.id}) }}"
                       class="flex items-center gap-3 px-4 py-3 hover:bg-[#84DCCF]/10 transition-colors
                              {{ ami.id == ami_selectionne.id ? 'bg-[#84DCCF]/15 border-r-2 border-[#00A9A5]' : '' }}">
                        <div class="w-9 h-9 rounded-full bg-[#00A9A5] text-white flex items-center justify-center font-bold text-sm flex-shrink-0">
                            {{ ami.prenomUtilisateur|slice(0,1)|upper }}
                        </div>
                        <span class="text-sm font-medium {{ ami.id == ami_selectionne.id ? 'text-[#00A9A5]' : 'text-[#4A4A4A]' }}">
                            {{ ami.prenomUtilisateur }}
                        </span>
                    </a>
                {% endfor %}
            </div>
        </div>

        {# ── Zone chat React ── #}
        <div class="flex-1 flex flex-col overflow-hidden">
            <div id="react-chat-root"
                 data-id-ami="{{ ami_selectionne.id }}"
                 data-prenom-ami="{{ ami_selectionne.prenomUtilisateur }}"
                 class="w-full h-full">
            </div>
        </div>

    </div>
</div>
{% endblock %}
