<div class="fixed top-6 left-6 bottom-6 w-[calc(100%-3rem)] md:w-[400px] rounded-3xl bg-white shadow-2xl z-[9999] overflow-hidden flex flex-col animate-[slideIn_0.3s_ease-out] border border-gray-100">
    
    <!-- Zone avec scroll si le contenu est trop long -->
    <div class="overflow-y-auto flex-grow h-full custom-scrollbar">
        <!-- En-tête / Bannière (Type Google Maps) -->
        <div class="relative w-full h-40 bg-indigo-50 flex items-center justify-center border-b border-gray-200">
            <!-- Bouton Fermer Fixé pour la barre latérale -->
            <button data-action="click->restaurant-modal#close" class="absolute top-4 right-4 bg-white/90 hover:bg-white text-gray-800 rounded-full w-10 h-10 flex items-center justify-center shadow-md transition-transform hover:scale-105 z-10 font-bold border border-gray-200">
                ✕
            </button>
            <span class="text-6xl opacity-75">🍽️</span>
        </div>

        <!-- Contenu Principal -->
        <div class="p-6 flex-grow flex flex-col gap-6">
        
        <div>
            <h2 class="text-3xl font-black text-gray-900 mb-1 leading-tight">{{ restaurant.nomRestaurant }}</h2>
            <p class="text-indigo-600 font-semibold flex items-center gap-2 mt-1">
                📍 {% if distance_km is not empty %}
                    À {{ distance_km|number_format(1) }} km
                {% else %}
                    Distance non calculée
                {% endif %}
            </p>
        </div>

        {% if restaurant.adresseRestaurant %}
            <div class="border-t border-gray-100 pt-4">
                <h3 class="font-bold text-gray-400 uppercase text-xs tracking-wider mb-2 flex items-center gap-2">
                    <span>🗺️</span> Adresse
                </h3>
                <p class="text-gray-800 font-medium">{{ restaurant.adresseRestaurant }}</p>
            </div>
        {% endif %}

        {% if restaurant.descriptionRestaurant %}
            <div class="border-t border-gray-100 pt-4">
                <h3 class="font-bold text-gray-400 uppercase text-xs tracking-wider mb-2 flex items-center gap-2">
                    <span>📝</span> Description
                </h3>
                <p class="text-gray-600 leading-relaxed text-sm">{{ restaurant.descriptionRestaurant }}</p>
            </div>
        {% endif %}

        <div class="border-t border-gray-100 pt-4">
            <h3 class="font-bold text-gray-400 uppercase text-xs tracking-wider mb-3 flex items-center gap-2">
                <span>🎉</span> Événements
            </h3>
            
            {% if event_status == 'today' %}
                <div class="bg-green-50 border border-green-200 text-green-900 p-4 rounded-xl flex gap-3 shadow-sm">
                    <span class="text-2xl pt-1">🔥</span>
                    <div>
                        <p class="font-bold text-lg">Aujourd'hui !</p>
                        <p class="text-sm opacity-80">Des utilisateurs se réunissent dans ce restaurant aujourd'hui.</p>
                    </div>
                </div>
            {% elseif event_status == 'soon' %}
                <div class="bg-blue-50 border border-blue-200 text-blue-900 p-4 rounded-xl flex gap-3 shadow-sm">
                    <span class="text-2xl pt-1">📅</span>
                    <div>
                        <p class="font-bold text-lg">Prochainement</p>
                        <p class="text-sm opacity-80">Un événement est organisé ici dans les jours à venir.</p>
                    </div>
                </div>
            {% else %}
                <div class="bg-gray-50 border border-gray-200 text-gray-700 p-4 rounded-xl flex gap-3 shadow-sm">
                    <span class="text-2xl pt-1">😴</span>
                    <div>
                        <p class="font-bold text-lg">Aucun événement</p>
                        <p class="text-sm opacity-80">Soyez le premier à organiser un repas ici !</p>
                    </div>
                </div>
            {% endif %}
        </div>
        
    </div>
    </div>
</div>
