<div class="absolute top-0 left-0 bottom-0 w-[85vw] md:w-[400px] rounded-r-2xl bg-white shadow-2xl z-[9999] overflow-hidden flex flex-col animate-[slideIn_0.3s_ease-out] border-r border-y border-gray-100">

    <div class="overflow-y-auto flex-grow custom-scrollbar">

        {# ── Image de couverture ── #}
        <div class="relative w-full h-64 bg-gray-100 flex-shrink-0">
            {% if restaurant.logo %}
                <img src="{{ restaurant.logo }}" class="w-full h-full object-cover" alt="{{ restaurant.nomRestaurant }}">
            {% else %}
                <div class="w-full h-full flex flex-col items-center justify-center bg-gray-50 text-gray-300">
                    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1" stroke="currentColor" class="w-16 h-16">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 21v-7.5a.75.75 0 01.75-.75h3a.75.75 0 01.75.75V21m-4.5 0H2.36m11.14 0H18m0 0h3.64m-1.39 0V9.349m-16.5 11.65V9.35m0 0a3.001 3.001 0 003.75-.615A2.999 2.999 0 009.75 9.75c.896 0 1.7-.393 2.25-1.016a2.999 2.999 0 002.25 1.016c.896 0 1.7-.393 2.25-1.016a3.001 3.001 0 003.75.614m-16.5 0a3.004 3.004 0 01-.621-4.72L4.318 3.44A1.5 1.5 0 015.378 3h13.243a1.5 1.5 0 011.06.44l1.19 1.189a3 3 0 01-.621 4.72m-13.5 8.65h3.75L12 18z" />
                    </svg>
                    <span class="text-sm mt-2 text-gray-400">Image non disponible</span>
                </div>
            {% endif %}
            <button data-action="click->restaurant-modal#close"
                    class="absolute top-3 right-3 bg-white/90 hover:bg-white text-gray-600 hover:text-gray-900 rounded-full w-8 h-8 flex items-center justify-center shadow-md transition-all z-10">
                <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"/>
                </svg>
            </button>
        </div>

        {# ── Infos principales ── #}
        <div class="px-5 pt-4 pb-3">
            <h2 class="text-xl font-bold text-gray-900 leading-tight mb-1">{{ restaurant.nomRestaurant }}</h2>
            <div class="flex items-center gap-2 text-sm mb-3">
                {% if restaurant.noteConsommateurs %}
                    <span class="flex items-center gap-1 font-semibold text-yellow-500">
                        <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" viewBox="0 0 20 20" fill="currentColor"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/></svg>
                        {{ restaurant.noteConsommateurs|number_format(1, ',') }}
                    </span>
                {% endif %}
                {% if restaurant.type is not empty %}
                    {% if restaurant.noteConsommateurs %}<span class="text-gray-300">·</span>{% endif %}
                    <span class="text-gray-500">{{ restaurant.type|map(t => t.nomType)|join(', ') }}</span>
                {% endif %}
            </div>
            {% if restaurant.adresseRestaurant %}
            <div class="flex items-start gap-2.5 text-sm text-gray-600 mb-2">
                <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 mt-0.5 flex-shrink-0 text-gray-400" viewBox="0 0 24 24" fill="currentColor"><path fill-rule="evenodd" d="M11.54 22.351l.07.04.028.016a.76.76 0 00.723 0l.028-.015.071-.041a16.975 16.975 0 001.144-.742 19.58 19.58 0 002.683-2.282c1.944-1.99 3.963-4.98 3.963-8.827a8.25 8.25 0 00-16.5 0c0 3.846 2.02 6.837 3.963 8.827a19.58 19.58 0 002.682 2.282 16.975 16.975 0 001.145.742zM12 13.5a3 3 0 100-6 3 3 0 000 6z" clip-rule="evenodd"/></svg>
                <span>{{ restaurant.adresseRestaurant }}</span>
            </div>
            {% endif %}
            {% if restaurant.horaires %}
            <div class="flex items-center gap-2.5 text-sm text-gray-600 mb-2">
                <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 flex-shrink-0 text-gray-400" viewBox="0 0 24 24" fill="currentColor"><path fill-rule="evenodd" d="M12 2.25c-5.385 0-9.75 4.365-9.75 9.75s4.365 9.75 9.75 9.75 9.75-4.365 9.75-9.75S17.385 2.25 12 2.25zM12.75 6a.75.75 0 00-1.5 0v6c0 .414.336.75.75.75h4.5a.75.75 0 000-1.5h-3.75V6z" clip-rule="evenodd"/></svg>
                <span>{{ restaurant.horaires }}</span>
            </div>
            {% endif %}
            {% if restaurant.numTelRestaurant %}
            <div class="flex items-center gap-2.5 text-sm text-gray-600 mb-2">
                <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 flex-shrink-0 text-gray-400" viewBox="0 0 24 24" fill="currentColor"><path fill-rule="evenodd" d="M1.5 4.5a3 3 0 013-3h1.372c.86 0 1.61.586 1.819 1.42l1.105 4.423a1.875 1.875 0 01-.694 1.955l-1.293.97c-.135.101-.164.249-.126.352a11.285 11.285 0 006.697 6.697c.103.038.25.009.352-.126l.97-1.293a1.875 1.875 0 011.955-.694l4.423 1.105c.834.209 1.42.959 1.42 1.82V19.5a3 3 0 01-3 3h-2.25C8.552 22.5 1.5 15.448 1.5 6.75V4.5z" clip-rule="evenodd"/></svg>
                <span>{{ restaurant.numTelRestaurant }}</span>
            </div>
            {% endif %}
        </div>

        {# ── Onglets ── #}
        <div class="border-b border-gray-200 px-5">
            <nav class="flex gap-6">
                <button data-action="click->restaurant-modal#switchTab" data-tab="presentation"
                        class="text-[#00A9A5] font-medium text-sm pb-3 border-b-2 border-[#00A9A5] transition-colors cursor-pointer whitespace-nowrap">À propos</button>
                <button data-action="click->restaurant-modal#switchTab" data-tab="menu"
                        class="text-gray-500 font-medium text-sm pb-3 border-b-2 border-transparent hover:text-gray-800 transition-colors cursor-pointer">Menu</button>
                <button data-action="click->restaurant-modal#switchTab" data-tab="events"
                        class="text-gray-500 font-medium text-sm pb-3 border-b-2 border-transparent hover:text-gray-800 transition-colors cursor-pointer">Événements</button>
            </nav>
        </div>

        {# ── Contenu des onglets ── #}
        <div class="px-5 py-4">

            {# À propos #}
            <div data-tab-content="presentation" class="block space-y-7">
                {% if restaurant.descriptionRestaurant %}
                <p class="text-sm text-gray-600 leading-relaxed pt-1">{{ restaurant.descriptionRestaurant|nl2br }}</p>
                {% endif %}
                {% if restaurant.specialite is not empty %}
                <div>
                    <h3 class="text-base font-bold text-gray-900 mb-3">Spécialités</h3>
                    <div class="flex flex-wrap gap-2">
                        {% for spec in restaurant.specialite %}
                            <span class="text-xs bg-[#84DCCF]/20 text-[#00A9A5] px-3 py-1 rounded-full font-medium">{{ spec.nomSpecialite }}</span>
                        {% endfor %}
                    </div>
                </div>
                {% endif %}
                {% if restaurant.regimes is not empty %}
                <div>
                    <h3 class="text-base font-bold text-gray-900 mb-3">Régimes</h3>
                    <div class="flex flex-wrap gap-2">
                        {% for regime in restaurant.regimes %}
                            <span class="text-xs bg-gray-100 text-gray-600 px-3 py-1 rounded-full">{{ regime.nomRegime }}</span>
                        {% endfor %}
                    </div>
                </div>
                {% endif %}
                {% if restaurant.amenagements is not empty %}
                <div>
                    <h3 class="text-base font-bold text-gray-900 mb-3">Équipements</h3>
                    <div class="flex flex-wrap gap-2">
                        {% for amenagement in restaurant.amenagements %}
                            <span class="text-xs bg-gray-100 text-gray-600 px-3 py-1 rounded-full border border-gray-200">{{ amenagement.nomAmenagement }}</span>
                        {% endfor %}
                    </div>
                </div>
                {% endif %}
                {% if restaurant.siteWeb %}
                <a href="{{ restaurant.siteWeb }}" target="_blank" rel="noopener noreferrer"
                   class="flex items-center gap-2 text-sm text-[#00A9A5] hover:underline">
                    <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M12 21a9.004 9.004 0 008.716-6.747M12 21a9.004 9.004 0 01-8.716-6.747M12 21c2.485 0 4.5-4.03 4.5-9S14.485 3 12 3m0 18c-2.485 0-4.5-4.03-4.5-9S9.515 3 12 3"/></svg>
                    {{ restaurant.siteWeb }}
                </a>
                {% endif %}
                {% if not restaurant.descriptionRestaurant and restaurant.specialite is empty and restaurant.amenagements is empty and restaurant.regimes is empty %}
                    <p class="text-sm text-gray-400 italic text-center py-8">Aucune information disponible.</p>
                {% endif %}
            </div>

            {# Menu #}
            <div data-tab-content="menu" class="hidden">
                {% if restaurant.carteMenu %}
                    <img src="{{ restaurant.carteMenu }}" alt="Menu du restaurant" class="w-full rounded-xl border border-gray-100 object-contain">
                {% else %}
                    <div class="flex flex-col items-center justify-center py-12 text-gray-400">
                        <svg xmlns="http://www.w3.org/2000/svg" class="w-10 h-10 mb-3" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2"/></svg>
                        <p class="text-sm">Aucun menu disponible.</p>
                    </div>
                {% endif %}
            </div>

            {# Événements #}
            <div data-tab-content="events" class="hidden">
                {% if restaurant.evenements is not empty %}
                    <div class="flex flex-col gap-3">
                        {% for evenement in restaurant.evenements %}
                            <div class="rounded-xl border border-gray-100 p-4 hover:border-[#00A9A5]/40 hover:bg-[#84DCCF]/5 cursor-pointer transition-all"
                                 data-action="click->restaurant-modal#openEventModal" data-event-id="{{ evenement.id }}">
                                <h4 class="font-semibold text-gray-800 text-sm mb-2">{{ evenement.titre }}</h4>
                                <div class="flex items-center justify-between">
                                    <span class="text-xs text-gray-400">{{ evenement.dateEvenement ? evenement.dateEvenement|date('d/m/Y · H\\hi') : 'Date non définie' }}</span>
                                    {% set places_restantes = (evenement.nombrePlaces|default(0)) - (evenement.utilisateurs|length) %}
                                    {% if evenement.nombrePlaces %}
                                        <span class="text-xs font-medium {{ places_restantes > 0 ? 'text-[#00A9A5]' : 'text-red-400' }}">
                                            {{ places_restantes > 0 ? places_restantes ~ ' place' ~ (places_restantes > 1 ? 's' : '') ~ ' restante' ~ (places_restantes > 1 ? 's' : '') : 'Complet' }}
                                        </span>
                                    {% endif %}
                                </div>
                            </div>
                        {% endfor %}
                    </div>
                {% else %}
                    <div class="flex flex-col items-center justify-center py-12 text-gray-400">
                        <svg xmlns="http://www.w3.org/2000/svg" class="w-10 h-10 mb-3" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1"><path stroke-linecap="round" stroke-linejoin="round" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/></svg>
                        <p class="text-sm">Aucun événement à venir.</p>
                    </div>
                {% endif %}
            </div>

        </div>
    </div>
</div>

{# ── Modales d'événements ── #}
{% if restaurant.evenements is not empty %}
    {% for evenement in restaurant.evenements %}
        {% set taken     = evenement.utilisateurs|length %}
        {% set capacity  = evenement.nombrePlaces|default(0) %}
        {% set remaining = capacity > taken ? capacity - taken : 0 %}
        {% set pct       = capacity > 0 ? min((taken / capacity) * 100, 100) : 0 %}
        {% set is_joined = app.user and evenement.utilisateurs.contains(app.user) %}
        {% set is_creator = app.user and evenement.createur and app.user.id == evenement.createur.id %}

        <div id="event-modal-{{ evenement.id }}"
             class="fixed inset-0 z-[10000] hidden flex items-center justify-center p-4 sm:p-6"
             style="background: rgba(17,24,39,0.5);"
             data-action="click->restaurant-modal#closeEventModalOutside">

            <div class="relative w-full max-w-2xl bg-white rounded-3xl overflow-hidden"
                 style="box-shadow: 0 24px 60px -20px rgba(0,0,0,0.3);">

                {# ── Header dégradé ── #}
                <div class="relative px-7 pt-6 pb-5"
                     style="background: linear-gradient(135deg, #00A9A5 0%, #84DCCF 100%);">

                    <button type="button"
                            data-action="click->restaurant-modal#closeEventModal"
                            data-event-id="{{ evenement.id }}"
                            class="absolute top-4 right-4 w-9 h-9 rounded-full flex items-center justify-center text-white transition hover:bg-white/30"
                            style="background: rgba(255,255,255,0.2);">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
                    </button>

                    <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full mb-3 text-white text-xs font-medium"
                          style="background: rgba(255,255,255,0.22);">
                        <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><rect x="3" y="4" width="18" height="18" rx="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
                        Événement
                    </span>

                    <h2 class="text-white font-semibold leading-tight" style="font-size:22px;">
                        {{ evenement.titre }}
                    </h2>

                    <div class="flex flex-wrap gap-x-5 gap-y-2 mt-3 text-sm" style="color: rgba(255,255,255,0.9);">
                        <span class="inline-flex items-center gap-1.5">
                            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
                            {{ evenement.dateEvenement ? evenement.dateEvenement|date('d/m/Y') : 'N/C' }}
                            {% if evenement.dateFin %} → {{ evenement.dateFin|date('d/m/Y') }}{% endif %}
                        </span>
                        <span class="inline-flex items-center gap-1.5">
                            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
                            {{ taken }}{% if capacity > 0 %}/{{ capacity }}{% endif %} participants
                        </span>
                    </div>
                </div>

                {# ── Body ── #}
                <div class="px-7 py-6 grid grid-cols-1 md:grid-cols-5 gap-6 max-h-[60vh] overflow-y-auto">

                    {# Colonne gauche : description + participants #}
                    <section class="md:col-span-3 space-y-5">

                        <div>
                            <div class="uppercase tracking-wider mb-2" style="color:#99A1AF;font-size:11px;font-weight:600;">Description</div>
                            <p style="color:#4A4A4A;font-size:14px;line-height:1.65;">
                                {% if evenement.descriptionEvenement %}
                                    {{ evenement.descriptionEvenement|nl2br }}
                                {% else %}
                                    <span style="color:#99A1AF;font-style:italic;">Aucune description.</span>
                                {% endif %}
                            </p>
                        </div>

                        <div>
                            <div class="uppercase tracking-wider mb-3" style="color:#99A1AF;font-size:11px;font-weight:600;">Participants</div>
                            <ul class="space-y-2">
                                {% for p in evenement.utilisateurs %}
                                    {% set is_me       = app.user and app.user.id == p.id %}
                                    {% set is_organizer = evenement.createur and p.id == evenement.createur.id %}
                                    <li class="flex items-center gap-3 px-3 py-2 rounded-xl" style="background:#F8F8F8;">
                                        <div class="w-8 h-8 rounded-full flex items-center justify-center text-white flex-shrink-0"
                                             style="background: {{ is_organizer ? '#FF6B6B' : '#00A9A5' }};font-size:13px;font-weight:600;">
                                            {{ p.prenomUtilisateur|slice(0,1)|upper }}
                                        </div>
                                        <span style="color:#4A4A4A;font-size:14px;">
                                            {{ p.prenomUtilisateur }}{% if is_me %} <span style="color:#99A1AF;">(Moi)</span>{% endif %}
                                        </span>
                                        {% if is_organizer %}
                                            <span class="ml-auto px-2 py-0.5 rounded-full text-xs font-semibold flex-shrink-0"
                                                  style="background: rgba(255,107,107,0.12); color:#FF6B6B;">Organisateur</span>
                                        {% elseif not is_me %}
                                            <a href="/ami/add/{{ p.id }}"
                                               class="ml-auto w-7 h-7 rounded-full flex items-center justify-center font-bold text-base transition-colors flex-shrink-0"
                                               style="color:#00A9A5;border:1.5px solid #00A9A5;"
                                               title="Ajouter en ami">+</a>
                                        {% endif %}
                                    </li>
                                {% else %}
                                    <li style="color:#99A1AF;font-size:14px;font-style:italic;">Aucun participant pour le moment.</li>
                                {% endfor %}
                            </ul>
                        </div>
                    </section>

                    {# Colonne droite : stats + dates #}
                    <aside class="md:col-span-2 space-y-4">
                        {% if capacity > 0 %}
                        <div class="rounded-2xl p-4" style="background:#F8F8F8;">
                            <div style="color:#4A4A4A;font-size:13px;font-weight:600;">Places restantes</div>
                            <div class="flex items-baseline gap-1 mt-1">
                                <span style="color:#00A9A5;font-size:30px;font-weight:700;line-height:1;">{{ remaining }}</span>
                                <span style="color:#99A1AF;font-size:14px;">/ {{ capacity }}</span>
                            </div>
                            <div class="mt-3 h-1.5 rounded-full overflow-hidden" style="background:#E5E7EB;">
                                <div class="h-full rounded-full" style="width:{{ pct }}%;background:linear-gradient(90deg,#00A9A5,#84DCCF);"></div>
                            </div>
                        </div>
                        {% endif %}

                        {% if evenement.dateEvenement %}
                        <div class="flex items-center gap-3 px-4 py-3 rounded-xl" style="border:1px solid #F1F1F1;">
                            <div class="w-8 h-8 rounded-lg flex items-center justify-center flex-shrink-0" style="background:rgba(0,169,165,0.1);color:#00A9A5;">
                                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><rect x="3" y="4" width="18" height="18" rx="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
                            </div>
                            <div>
                                <div class="uppercase" style="color:#99A1AF;font-size:11px;letter-spacing:.06em;">Début</div>
                                <div style="color:#4A4A4A;font-size:14px;font-weight:500;">{{ evenement.dateEvenement|date('d/m/Y') }}</div>
                            </div>
                        </div>
                        {% endif %}

                        {% if evenement.dateFin %}
                        <div class="flex items-center gap-3 px-4 py-3 rounded-xl" style="border:1px solid #F1F1F1;">
                            <div class="w-8 h-8 rounded-lg flex items-center justify-center flex-shrink-0" style="background:rgba(0,169,165,0.1);color:#00A9A5;">
                                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><rect x="3" y="4" width="18" height="18" rx="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
                            </div>
                            <div>
                                <div class="uppercase" style="color:#99A1AF;font-size:11px;letter-spacing:.06em;">Fin</div>
                                <div style="color:#4A4A4A;font-size:14px;font-weight:500;">{{ evenement.dateFin|date('d/m/Y') }}</div>
                            </div>
                        </div>
                        {% endif %}
                    </aside>
                </div>

                {# ── Footer ── #}
                <div class="px-7 py-4 flex flex-wrap items-center justify-between gap-3"
                     style="border-top:1px solid #F1F1F1;background:#FCFCFC;">

                    {% if evenement.restaurant %}
                    <div class="inline-flex items-center gap-2 text-xs" style="color:#99A1AF;">
                        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
                        {{ evenement.restaurant.nomRestaurant }}{% if evenement.restaurant.adresseRestaurant %} · {{ evenement.restaurant.adresseRestaurant }}{% endif %}
                    </div>
                    {% else %}
                    <div></div>
                    {% endif %}

                    {% if not is_creator %}
                    <a href="/event/join/{{ evenement.id }}"
                       class="px-5 py-2.5 rounded-xl text-white text-sm font-semibold transition hover:opacity-90"
                       style="{{ is_joined ? 'background:#FF6B6B;box-shadow:0 6px 16px -6px rgba(255,107,107,0.5);' : 'background:#00A9A5;box-shadow:0 6px 16px -6px rgba(0,169,165,0.5);' }}">
                        {{ is_joined ? 'Quitter l\'événement' : 'Rejoindre l\'événement' }}
                    </a>
                    {% else %}
                    <span class="px-5 py-2.5 rounded-xl text-sm font-semibold"
                          style="background:rgba(0,169,165,0.1);color:#00A9A5;">
                        Vous organisez cet événement
                    </span>
                    {% endif %}
                </div>

            </div>
        </div>
    {% endfor %}
{% endif %}

