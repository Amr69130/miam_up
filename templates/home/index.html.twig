{% extends 'base.html.twig' %}

{% block title %}Accueil - Miam Up{% endblock %}

{% block body %}
<div class="flex min-h-screen bg-gray-50">

    {% include 'components/_nav.html.twig' %}

    {# Contenu principal #}
    <main class="flex-1 flex flex-col items-center justify-center py-20 px-4">
        <div class="text-center max-w-2xl">
            <h1 class="text-5xl font-bold text-slate-900 mb-6">
                🍽️ Bienvenue sur Miam Up !
            </h1>

            {% if app.user %}
                <p class="text-xl text-gray-600 mb-8">
                    Ravi de vous revoir, <span class="font-semibold text-blue-600">{{ app.user.prenomUtilisateur }} {{ app.user.nomUtilisateur }}</span> !
                </p>

                <div class="bg-white rounded-2xl shadow-lg p-8 text-left">
                    <h2 class="text-2xl font-bold text-slate-800 mb-6">Votre profil</h2>
                    <div class="grid sm:grid-cols-2 gap-4">
                        <div class="bg-gray-50 rounded-xl p-4">
                            <p class="text-sm text-gray-500">Pseudo</p>
                            <p class="text-lg font-semibold text-slate-900">{{ app.user.pseudoUtilisateur }}</p>
                        </div>
                        <div class="bg-gray-50 rounded-xl p-4">
                            <p class="text-sm text-gray-500">Email</p>
                            <p class="text-lg font-semibold text-slate-900">{{ app.user.emailUtilisateur }}</p>
                        </div>
                        <div class="bg-gray-50 rounded-xl p-4">
                            <p class="text-sm text-gray-500">Téléphone</p>
                            <p class="text-lg font-semibold text-slate-900">{{ app.user.numUtilisateur }}</p>
                        </div>
                        <div class="bg-gray-50 rounded-xl p-4">
                            <p class="text-sm text-gray-500">Rôles</p>
                            <div class="flex flex-wrap gap-2 mt-1">
                                {% for role in app.user.roles %}
                                    <span class="text-xs font-medium px-2.5 py-1 rounded-full 
                                        {% if role == 'ROLE_ADMIN' %}
                                            bg-purple-100 text-purple-800
                                        {% else %}
                                            bg-blue-100 text-blue-800
                                        {% endif %}">
                                        {{ role }}
                                    </span>
                                {% endfor %}
                            </div>
                        </div>
                    </div>
                </div>
            {% else %}
                <p class="text-xl text-gray-600 mb-8">
                    Trouvez les meilleurs restaurants autour de vous et partagez vos expériences culinaires.
                </p>

                <div class="flex flex-col sm:flex-row gap-4 justify-center">
                    <a href="{{ path('app_utilisateur_register') }}" 
                       class="bg-blue-500 hover:bg-blue-600 text-white font-semibold px-8 py-4 rounded-xl text-lg transition-colors shadow-lg hover:shadow-xl">
                        Créer un compte
                    </a>
                    <a href="{{ path('app_utilisateur_login') }}" 
                       class="bg-white hover:bg-gray-50 text-slate-900 font-semibold px-8 py-4 rounded-xl text-lg transition-colors shadow-lg hover:shadow-xl border border-gray-200">
                        Se connecter
                    </a>
                </div>
            {% endif %}
        </div>
    </main>
</div>
{% endblock %}
