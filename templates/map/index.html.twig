{% extends 'base.html.twig' %}

{% block title %}Carte Miam'Up{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    {{ encore_entry_link_tags('app') }}
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    {{ encore_entry_script_tags('app') }}
{% endblock %}

{% block body %}
    <div class="container mx-auto px-4 py-8">

        {# 1.2 : Mise en place de la barre de recherche / actions #}
        <div class="max-w-4xl mx-auto mb-10">
            <div class="flex flex-col md:flex-row items-center justify-center gap-4 bg-white p-4 rounded-2xl shadow-sm border border-gray-100">

                {# Simulation du champ de recherche pour le contexte de la barre #}
                <div class="relative w-full md:w-64">
                    <input type="text" placeholder="Rechercher un restaurant..."
                           class="w-full pl-10 pr-4 py-2 rounded-full border border-gray-200 focus:ring-2 focus:ring-orange-500 outline-none text-sm">
                    <svg class="w-4 h-4 absolute left-3 top-2.5 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
                    </svg>
                </div>

                <span class="hidden md:block text-gray-300">|</span>

                {# 1.2 : Création du composant bouton "Autour de moi" #}
                <button id="btn-geoloc"
                        class="flex items-center gap-2 bg-orange-500 hover:bg-orange-600 text-white font-bold py-2.5 px-6 rounded-full transition-all active:scale-95 shadow-md whitespace-nowrap">

                    {# 1.2 : Ajout de l'icône SVG (Cible/GPS) #}
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
                    </svg>

                    <span>Autour de moi</span>
                </button>
            </div>
        </div>

        {# Point d'entrée de ta carte React #}
        <div id="react-map-root"
             class="rounded-3xl overflow-hidden shadow-2xl border-4 border-white min-h-[600px] bg-gray-100"
             data-items="{{ restaurants_json }}">
        </div>

    </div>
{% endblock %}
