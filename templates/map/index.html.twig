{% extends 'base.html.twig' %}

{% block title %}Carte Miam'Up{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    {{ encore_entry_link_tags('app') }}
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    {{ encore_entry_script_tags('app') }}
{% endblock %}

{% block body %}
    <div class="container mx-auto px-4 py-8">

        {# 1.2 & 1.3 : Barre de recherche et Bouton avec Feedback #}
        <div class="max-w-4xl mx-auto mb-10 text-center">
            <div class="flex flex-col md:flex-row items-center justify-center gap-4 bg-white p-4 rounded-2xl shadow-sm border border-gray-100">

                {# Champ de recherche (CORRIGÉ avec Stimulus) #}
                <div class="relative w-full md:w-80 flex gap-2" data-controller="search-filter">
                    <div class="relative flex-grow">
                        <input type="text"
                               id="search-input"
                               data-action="keydown.enter->search-filter#filter"
                               placeholder="Rechercher un restaurant..."
                               class="w-full pl-10 pr-4 py-2 rounded-full border border-gray-200 focus:ring-2 focus:ring-orange-500 outline-none text-sm">
                        <svg class="w-4 h-4 absolute left-3 top-2.5 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
                        </svg>
                    </div>
                    <button id="btn-search-confirm"
                            data-action="click->search-filter#filter"
                            class="bg-gray-800 text-white px-4 py-2 rounded-full hover:bg-black transition text-sm font-bold shadow-sm">
                        OK
                    </button>
                </div>

                <span class="hidden md:block text-gray-300">|</span>

                {# Contrôleur Stimulus (Autour de moi) #}
                <div data-controller="search-location">
                    <button data-search-location-target="button"
                            data-action="click->search-location#findMe"
                            id="btn-geoloc"
                            class="flex items-center gap-2 bg-orange-500 hover:bg-orange-600 disabled:bg-gray-400 disabled:cursor-not-allowed text-white font-bold py-2.5 px-6 rounded-full transition-all active:scale-95 shadow-md whitespace-nowrap">

                        <svg data-search-location-target="iconTarget" id="icon-target" xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
                        </svg>

                        <svg data-search-location-target="iconSpinner" id="icon-spinner" class="hidden animate-spin h-5 w-5 text-white" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
                            <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                            <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
                        </svg>

                        <span data-search-location-target="label" id="btn-text">Autour de moi</span>
                    </button>
                    <div data-search-location-target="message" id="geoloc-message" class="hidden mt-2 p-2 text-sm rounded-md border"></div>
                </div>
            </div>
        </div>

        {# Point d'entrée de ta carte React #}
        <div id="react-map-root"
             class="rounded-3xl overflow-hidden shadow-2xl border-4 border-white min-h-[600px] bg-gray-100"
             data-items="{{ restaurants_json }}">
        </div>

    </div>
{% endblock %}
