{% extends 'base.html.twig' %}

{% block title %}Carte Miam'Up{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    {{ encore_entry_link_tags('app') }}
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    {{ encore_entry_script_tags('app') }}

    <script>
        document.addEventListener('DOMContentLoaded', () => {
            setTimeout(() => {
                const flashMessages = document.querySelectorAll('.flash-message-container');
                const geolocMessage = document.getElementById('geoloc-message');

                const fadeOut = (el) => {
                    if (el && !el.classList.contains('hidden')) {
                        el.style.transition = "opacity 0.6s ease, transform 0.6s ease";
                        el.style.opacity = "0";
                        el.style.transform = "translateY(-10px)";
                        setTimeout(() => el.classList.add('hidden'), 600);
                    }
                };

                flashMessages.forEach(msg => fadeOut(msg));
                if (geolocMessage && !geolocMessage.classList.contains('text-red-600')) {
                    fadeOut(geolocMessage);
                }
            }, 5000);
        });
    </script>
{% endblock %}

{% block body %}
    {# --- 1. MESSAGES FLASH (FORÇAGE DU TEXTE EN BLANC) --- #}
    {% for message in app.flashes('success') %}
        <div class="flash-message-container fixed top-6 right-6 z-[100] animate-bounce">
            <div class="bg-green-600 p-5 rounded-2xl shadow-2xl flex items-center gap-3 border-b-4 border-green-800">
                {# On utilise un emoji simple au cas où le SVG beugue #}
                <span class="text-2xl">✅</span>
                <span class="font-black text-white text-lg drop-shadow-sm">
                    {{ message|raw }}
                </span>
            </div>
        </div>
    {% endfor %}

    {# --- 2. BOUTON FLOTTANT --- #}
    <div class="fixed bottom-10 right-10 z-[90]">
        <a href="{{ path('app_evenement_test') }}"
           class="flex items-center gap-3 bg-[#FF6B6B] hover:bg-[#e55a5a] text-white px-8 py-4 rounded-full font-black shadow-2xl transition-all hover:scale-110 active:scale-95 border-4 border-white">
            <span class="text-2xl">🔥</span>
            <span class="text-white">ORGANISER UN EVENT</span>
        </a>
    </div>

    <div class="container mx-auto px-4 py-8">

        {# MODAL CONTAINER FOR RESTAURANT DETAILS #}
        <div data-controller="restaurant-modal">
            <div data-restaurant-modal-target="container"></div>
        </div>

        {# BLOC RECHERCHE ET GEOLOC #}
        <div class="max-w-4xl mx-auto mb-10 text-center" data-controller="search-location">
            <div class="flex flex-col md:flex-row items-center justify-center gap-4 bg-white p-4 rounded-2xl shadow-sm border border-gray-200">

                <div class="relative w-full md:w-80 flex gap-2">
                    <div class="relative flex-grow">
                        <input type="text"
                               id="search-input"
                               data-action="keydown.enter->search-location#filter"
                               placeholder="Rechercher un restaurant..."
                               class="w-full pl-10 pr-4 py-2 rounded-full border border-gray-200 focus:ring-2 focus:ring-[#00A9A5] outline-none text-sm text-gray-900">
                        <span class="absolute left-3 top-2 text-gray-400">🔍</span>
                    </div>
                    <button type="button"
                            id="btn-search-confirm"
                            data-action="click->search-location#filter"
                            class="bg-[#4A4A4A] text-white px-4 py-2 rounded-full hover:bg-[#333] transition text-sm font-bold">
                        OK
                    </button>
                </div>

                <span class="hidden md:block text-gray-300">|</span>

                <div class="relative">
                    <button data-search-location-target="button"
                            data-action="click->search-location#findMe"
                            id="btn-geoloc"
                            class="flex items-center gap-2 bg-[#00A9A5] hover:bg-[#008F8C] text-white font-bold py-2.5 px-6 rounded-full transition-all shadow-md">
                        <span data-search-location-target="label" id="btn-text">Autour de moi</span>
                    </button>

                    {# Message de feedback géo (Forçage texte noir) #}
                    <div data-search-location-target="message"
                         id="geoloc-message"
                         class="hidden absolute top-full left-1/2 -translate-x-1/2 mt-2 w-max max-w-xs p-3 rounded-lg border bg-white shadow-xl z-50 text-gray-900 font-bold">
                    </div>
                </div>
            </div>
        </div>

        {# 3. POINT D'ENTRÉE REACT #}
        <div id="react-map-root"
             class="rounded-3xl overflow-hidden shadow-2xl border-4 border-white min-h-[600px] bg-gray-200"
             data-items="{{ restaurants_json }}">
        </div>

    </div>
{% endblock %}
