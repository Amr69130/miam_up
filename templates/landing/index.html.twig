{# NOTE IMPORTANTE POUR LANCER LA PAGE EN LOCALHOST
- lancer la requete : "php -S localhost:8000 -t public" dans un premier TERMINAL
- Lancer la requete : "npm run watch" dans un deuxieme TERMINE en simultané pour avoir l'affichage du CSS

 #}

{% extends 'base.html.twig' %}

{% block title %}Accueil - Miam Up{% endblock %}

{% block body %}
<div class="min-h-screen bg-[#F8F8F8]">

    {# Navbar #}
    <nav class="bg-white shadow-sm sticky top-0 z-50">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="flex justify-between items-center h-16">
                {# Logo #}
                <a href="#" class="flex items-center gap-2">
                    <img src="{{ asset('images/logo-miamup.png') }}" alt="Logo Miam Up" class="h-10 w-auto object-contain">
                </a>

                {# Navigation centrale #}
                <div class="hidden md:flex items-center gap-8">
                    <a href="#map-section" class="flex items-center gap-1 text-[#00A9A5] font-medium transition-colors">
                        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 20l-5.447-2.724A1 1 0 013 16.382V5.618a1 1 0 011.447-.894L9 7m0 13l6-3m-6 3V7m6 10l4.553 2.276A1 1 0 0121 18.382V7.618a1 1 0 01-.553-.894L15 7m0 13V7"></path>
                        </svg>
                        Explorer la carte
                    </a>
                    <a href="#restaurants" class="text-[#4A4A4A] hover:text-[#00A9A5] font-medium transition-colors">Restaurants</a>
                    <a href="#evenements" class="text-[#4A4A4A] hover:text-[#00A9A5] font-medium transition-colors">Événements</a>
                    <a href="#communaute" class="text-[#4A4A4A] hover:text-[#00A9A5] font-medium transition-colors">Communauté</a>
                </div>

                {# Navigation droite #}
                <div class="flex items-center gap-3">
                    {# Localisation utilisateur #}
                    <button class="hidden sm:flex items-center gap-2 text-sm text-[#00A9A5] bg-[#84DCCF]/10 px-3 py-2 rounded-lg hover:bg-[#84DCCF]/20 transition-colors">
                        <svg class="w-4 h-4 animate-pulse" fill="currentColor" viewBox="0 0 20 20">
                            <path fill-rule="evenodd" d="M5.05 4.05a7 7 0 119.9 9.9L10 18.9l-4.95-4.95a7 7 0 010-9.9zM10 11a2 2 0 100-4 2 2 0 000 4z" clip-rule="evenodd"></path>
                        </svg>
                        <span class="font-medium">Paris 11ème</span>
                    </button>
                    
                    {# 
                    {% if app.user %}
                        <a href="#" class="relative p-2 text-[#4A4A4A] hover:text-[#00A9A5] transition-colors">
                            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 17h5l-1.405-1.405A2.032 2.032 0 0118 14.158V11a6.002 6.002 0 00-4-5.659V5a2 2 0 10-4 0v.341C7.67 6.165 6 8.388 6 11v3.159c0 .538-.214 1.055-.595 1.436L4 17h5m6 0v1a3 3 0 11-6 0v-1m6 0H9"></path>
                            </svg>
                            <span class="absolute top-1 right-1 w-2 h-2 bg-[#FF6B6B] rounded-full"></span>
                        </a>
                        <a href="#" class="flex items-center gap-2">
                            <img src="{{ asset('images/avatar-default.jpg') }}" alt="Avatar" class="w-9 h-9 rounded-full border-2 border-[#84DCCF]">
                        </a>
                    {% else %}
                    #}
                        <a href="{{ path('app_utilisateur_login') }}" 
                           class="hidden sm:block text-sm text-[#4A4A4A] hover:text-[#00A9A5] font-medium transition-colors">
                            Se connecter
                        </a>
                        <a href="{{ path('app_utilisateur_register') }}" 
                           class="text-sm bg-[#00A9A5] hover:bg-[#008b87] text-white px-5 py-2.5 rounded-xl transition-all duration-200 font-medium shadow-md hover:shadow-lg">
                            Rejoindre
                        </a>
                    {# {% endif %} #}
                </div>
            </div>
        </div>
    </nav>

    {# Hero Section avec Map Preview #}
    <section class="relative overflow-hidden">
        <div class="absolute inset-0">
            <img src="{{ asset('images/community-food.jpg') }}" 
                 alt="Communauté culinaire" 
                 class="w-full h-full object-cover">
            <div class="absolute inset-0 bg-gradient-to-r from-[#4A4A4A]/90 via-[#4A4A4A]/70 to-transparent"></div>
        </div>
        
        <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16 lg:py-24">
            <div class="grid lg:grid-cols-2 gap-12 items-center">
                {# Texte #}
                <div>
                    <div class="inline-flex items-center gap-2 bg-white/10 backdrop-blur-sm rounded-full px-4 py-2 mb-6">
                        <span class="w-2 h-2 bg-[#84DCCF] rounded-full animate-pulse"></span>
                        <span class="text-white/90 text-sm font-medium">+2,500 gourmets près de chez vous</span>
                    </div>
                    
                    <h1 class="text-4xl sm:text-5xl lg:text-6xl font-extrabold text-white leading-tight mb-6">
                        Découvrez autour de 
                        <span class="text-[#84DCCF]">vous</span>
                    </h1>
                    
                    <p class="text-lg text-white/80 mb-8 max-w-lg">
                        Explorez la carte interactive, trouvez les meilleurs restaurants et événements culinaires à proximité. Partagez vos découvertes avec la communauté.
                    </p>
                    
                    {# Barre de recherche avec localisation #}
                    <div class="bg-white rounded-2xl shadow-2xl p-2 max-w-xl">
                        <div class="flex flex-col sm:flex-row gap-2">
                            <div class="flex-1 flex items-center gap-3 px-4 py-3 bg-gray-50 rounded-xl">
                                <svg class="w-5 h-5 text-[#00A9A5] flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"></path>
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"></path>
                                </svg>
                                <input type="text" 
                                       placeholder="Votre position : Paris 11ème" 
                                       class="w-full bg-transparent outline-none text-[#4A4A4A] placeholder-gray-400">
                            </div>
                            <button class="bg-[#FF6B6B] hover:bg-[#e55a5a] text-white px-6 py-3 rounded-xl font-semibold transition-all duration-200 shadow-lg hover:shadow-xl flex items-center justify-center gap-2">
                                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
                                </svg>
                                Explorer
                            </button>
                        </div>
                    </div>
                    
                    {# Tags de proximité #}
                    <div class="flex flex-wrap gap-2 mt-4">
                        <span class="text-white/60 text-sm">À proximité :</span>
                        <a href="#" class="text-sm text-white/80 hover:text-[#84DCCF] underline transition-colors">Restaurants < 500m</a>
                        <a href="#" class="text-sm text-white/80 hover:text-[#84DCCF] underline transition-colors">Événements ce soir</a>
                        <a href="#" class="text-sm text-white/80 hover:text-[#84DCCF] underline transition-colors">Groupes locaux</a>
                    </div>
                </div>
                
                {# Preview de la carte #}
                <div class="relative hidden lg:block">
                    <div class="relative rounded-2xl overflow-hidden shadow-2xl border-4 border-white/20">
                        <img src="{{ asset('images/map-preview.jpg') }}" 
                             alt="Carte interactive" 
                             class="w-full h-auto">
                        {# Overlay avec bouton #}
                        <div class="absolute inset-0 bg-[#4A4A4A]/30 flex items-center justify-center">
                            <a href="#map-section" class="bg-white text-[#00A9A5] px-6 py-3 rounded-xl font-bold shadow-lg hover:bg-gray-100 transition-colors flex items-center gap-2">
                                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 20l-5.447-2.724A1 1 0 013 16.382V5.618a1 1 0 011.447-.894L9 7m0 13l6-3m-6 3V7m6 10l4.553 2.276A1 1 0 0121 18.382V7.618a1 1 0 01-.553-.894L15 7m0 13V7"></path>
                                </svg>
                                Ouvrir la carte
                            </a>
                        </div>
                    </div>
                    {# Badge localisation #}
                    <div class="absolute -bottom-4 -left-4 bg-[#00A9A5] text-white px-4 py-2 rounded-xl shadow-lg flex items-center gap-2">
                        <span class="w-3 h-3 bg-white rounded-full animate-pulse"></span>
                        <span class="font-medium text-sm">12 restaurants à 5 min</span>
                    </div>
                </div>
            </div>
        </div>
    </section>

    {# Section Map Interactive #}
    <section id="map-section" class="py-8 px-4 sm:px-6 lg:px-8 bg-white">
        <div class="max-w-7xl mx-auto">
            <div class="flex flex-col lg:flex-row gap-6">
                {# Sidebar des filtres et résultats #}
                <div class="lg:w-80 flex-shrink-0">
                    <div class="bg-white rounded-2xl shadow-lg border border-gray-100 overflow-hidden">
                        {# Header avec localisation #}
                        <div class="bg-gradient-to-r from-[#00A9A5] to-[#84DCCF] p-4 text-white">
                            <div class="flex items-center gap-2 mb-2">
                                <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 20 20">
                                    <path fill-rule="evenodd" d="M5.05 4.05a7 7 0 119.9 9.9L10 18.9l-4.95-4.95a7 7 0 010-9.9zM10 11a2 2 0 100-4 2 2 0 000 4z" clip-rule="evenodd"></path>
                                </svg>
                                <span class="font-medium">Votre position</span>
                            </div>
                            <p class="text-white/90 text-sm">Paris 11ème, Boulevard Voltaire</p>
                            <div class="flex items-center gap-4 mt-3 text-sm">
                                <span class="bg-white/20 px-2 py-1 rounded-lg">Précision: ±15m</span>
                                <button class="text-white/80 hover:text-white underline">Actualiser</button>
                            </div>
                        </div>
                        
                        {# Filtres #}
                        <div class="p-4 border-b border-gray-100">
                            <h3 class="font-bold text-[#4A4A4A] mb-3">Afficher sur la carte</h3>
                            <div class="space-y-2">
                                <label class="flex items-center gap-3 p-2 rounded-lg hover:bg-gray-50 cursor-pointer transition-colors">
                                    <input type="checkbox" checked class="w-5 h-5 text-[#00A9A5] rounded focus:ring-[#00A9A5]">
                                    <span class="flex items-center gap-2">
                                        <span class="w-8 h-8 bg-[#84DCCF]/20 rounded-lg flex items-center justify-center">🍽️</span>
                                        <span class="text-[#4A4A4A]">Restaurants</span>
                                    </span>
                                    <span class="ml-auto text-sm text-gray-400">48</span>
                                </label>
                                <label class="flex items-center gap-3 p-2 rounded-lg hover:bg-gray-50 cursor-pointer transition-colors">
                                    <input type="checkbox" checked class="w-5 h-5 text-[#FF6B6B] rounded focus:ring-[#FF6B6B]">
                                    <span class="flex items-center gap-2">
                                        <span class="w-8 h-8 bg-[#FF6B6B]/20 rounded-lg flex items-center justify-center">📅</span>
                                        <span class="text-[#4A4A4A]">Événements</span>
                                    </span>
                                    <span class="ml-auto text-sm text-gray-400">12</span>
                                </label>
                                <label class="flex items-center gap-3 p-2 rounded-lg hover:bg-gray-50 cursor-pointer transition-colors">
                                    <input type="checkbox" class="w-5 h-5 text-[#00A9A5] rounded focus:ring-[#00A9A5]">
                                    <span class="flex items-center gap-2">
                                        <span class="w-8 h-8 bg-purple-100 rounded-lg flex items-center justify-center">👥</span>
                                        <span class="text-[#4A4A4A]">Membres actifs</span>
                                    </span>
                                    <span class="ml-auto text-sm text-gray-400">156</span>
                                </label>
                                <label class="flex items-center gap-3 p-2 rounded-lg hover:bg-gray-50 cursor-pointer transition-colors">
                                    <input type="checkbox" class="w-5 h-5 text-[#00A9A5] rounded focus:ring-[#00A9A5]">
                                    <span class="flex items-center gap-2">
                                        <span class="w-8 h-8 bg-yellow-100 rounded-lg flex items-center justify-center">⭐</span>
                                        <span class="text-[#4A4A4A]">Mes favoris</span>
                                    </span>
                                    <span class="ml-auto text-sm text-gray-400">8</span>
                                </label>
                            </div>
                        </div>
                        
                        {# Rayon de recherche #}
                        <div class="p-4 border-b border-gray-100">
                            <div class="flex justify-between items-center mb-2">
                                <h3 class="font-bold text-[#4A4A4A]">Rayon de recherche</h3>
                                <span class="text-[#00A9A5] font-bold">2 km</span>
                            </div>
                            <input type="range" min="0.5" max="10" step="0.5" value="2" 
                                   class="w-full h-2 bg-gray-200 rounded-lg appearance-none cursor-pointer accent-[#00A9A5]">
                            <div class="flex justify-between text-xs text-gray-400 mt-1">
                                <span>500m</span>
                                <span>10km</span>
                            </div>
                        </div>
                        
                        {# Résultats proches #}
                        <div class="p-4 max-h-80 overflow-y-auto">
                            <h3 class="font-bold text-[#4A4A4A] mb-3">À moins de 500m</h3>
                            <div class="space-y-3">
                                {% set proches = [
                                    {nom: 'Le Petit Bistro', type: 'Français', distance: '120m', note: 4.8, icon: '🍽️'},
                                    {nom: 'Café des Amis', type: 'Café', distance: '250m', note: 4.5, icon: '☕'},
                                    {nom: 'Sushi Express', type: 'Japonais', distance: '380m', note: 4.3, icon: '🍣'}
                                ] %}
                                {% for place in proches %}
                                    <div class="flex items-center gap-3 p-2 rounded-xl hover:bg-gray-50 cursor-pointer transition-colors group">
                                        <span class="w-10 h-10 bg-gray-100 rounded-lg flex items-center justify-center text-xl">{{ place.icon }}</span>
                                        <div class="flex-1 min-w-0">
                                            <p class="font-medium text-[#4A4A4A] group-hover:text-[#00A9A5] transition-colors truncate">{{ place.nom }}</p>
                                            <p class="text-sm text-gray-500">{{ place.type }} • {{ place.distance }}</p>
                                        </div>
                                        <div class="flex items-center gap-1 text-sm">
                                            <svg class="w-4 h-4 text-yellow-400" fill="currentColor" viewBox="0 0 20 20">
                                                <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"></path>
                                            </svg>
                                            <span class="font-bold">{{ place.note }}</span>
                                        </div>
                                    </div>
                                {% endfor %}
                            </div>
                        </div>
                    </div>
                </div>
                
                {# Zone de carte #}
                <div class="flex-1">
                    <div class="bg-gray-100 rounded-2xl overflow-hidden shadow-lg border border-gray-200 h-[600px] relative">
                        {# Placeholder pour la carte Leaflet/Mapbox #}
                        <img src="{{ asset('images/map-preview.jpg') }}" 
                             alt="Carte interactive" 
                             class="w-full h-full object-cover">
                    
                        
                        {# Boutons de contrôle de la carte #}
                        <div class="absolute top-4 right-4 flex flex-col gap-2">
                            <button class="w-10 h-10 bg-white rounded-xl shadow-lg flex items-center justify-center hover:bg-gray-50 transition-colors" title="Zoom +">
                                <svg class="w-5 h-5 text-[#4A4A4A]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6v6m0 0v6m0-6h6m-6 0H6"></path>
                                </svg>
                            </button>
                            <button class="w-10 h-10 bg-white rounded-xl shadow-lg flex items-center justify-center hover:bg-gray-50 transition-colors" title="Zoom -">
                                <svg class="w-5 h-5 text-[#4A4A4A]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20 12H4"></path>
                                </svg>
                            </button>
                            <button class="w-10 h-10 bg-[#00A9A5] rounded-xl shadow-lg flex items-center justify-center hover:bg-[#008b87] transition-colors" title="Ma position">
                                <svg class="w-5 h-5 text-white" fill="currentColor" viewBox="0 0 20 20">
                                    <path fill-rule="evenodd" d="M5.05 4.05a7 7 0 119.9 9.9L10 18.9l-4.95-4.95a7 7 0 010-9.9zM10 11a2 2 0 100-4 2 2 0 000 4z" clip-rule="evenodd"></path>
                                </svg>
                            </button>
                        </div>
                        
                        {# Légende #}
                        <div class="absolute bottom-4 left-4 bg-white rounded-xl shadow-lg p-3">
                            <div class="flex items-center gap-4 text-sm">
                                <div class="flex items-center gap-2">
                                    <span class="w-3 h-3 bg-[#84DCCF] rounded-full"></span>
                                    <span class="text-gray-600">Restaurant</span>
                                </div>
                                <div class="flex items-center gap-2">
                                    <span class="w-3 h-3 bg-[#FF6B6B] rounded-full"></span>
                                    <span class="text-gray-600">Événement</span>
                                </div>
                                <div class="flex items-center gap-2">
                                    <span class="w-3 h-3 bg-[#00A9A5] rounded-full animate-pulse"></span>
                                    <span class="text-gray-600">Vous</span>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>

    {# Stats Section avec localisation #}
    <section class="bg-white py-8 border-b border-gray-100">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="flex items-center justify-center gap-2 mb-6">
                <svg class="w-5 h-5 text-[#00A9A5]" fill="currentColor" viewBox="0 0 20 20">
                    <path fill-rule="evenodd" d="M5.05 4.05a7 7 0 119.9 9.9L10 18.9l-4.95-4.95a7 7 0 010-9.9zM10 11a2 2 0 100-4 2 2 0 000 4z" clip-rule="evenodd"></path>
                </svg>
                <span class="text-gray-500">Dans un rayon de <span class="text-[#00A9A5] font-bold">2 km</span> autour de vous</span>
            </div>
            <div class="grid grid-cols-2 md:grid-cols-4 gap-6 text-center">
                <div class="p-4 rounded-2xl bg-[#84DCCF]/10">
                    <p class="text-3xl font-bold text-[#00A9A5]">48</p>
                    <p class="text-sm text-gray-500">Restaurants à proximité</p>
                </div>
                <div class="p-4 rounded-2xl bg-[#84DCCF]/10">
                    <p class="text-3xl font-bold text-[#00A9A5]">156</p>
                    <p class="text-sm text-gray-500">Gourmets connectés</p>
                </div>
                <div class="p-4 rounded-2xl bg-[#FF6B6B]/10">
                    <p class="text-3xl font-bold text-[#FF6B6B]">12</p>
                    <p class="text-sm text-gray-500">Événements ce soir</p>
                </div>
                <div class="p-4 rounded-2xl bg-purple-50">
                    <p class="text-3xl font-bold text-purple-600">3</p>
                    <p class="text-sm text-gray-500">Nouveautés cette semaine</p>
                </div>
            </div>
        </div>
    </section>

    {# Événements à proximité #}
    <section id="evenements" class="py-16 px-4 sm:px-6 lg:px-8">
        <div class="max-w-7xl mx-auto">
            <div class="flex justify-between items-center mb-8">
                <div>
                    <div class="flex items-center gap-2 mb-1">
                        <svg class="w-5 h-5 text-[#00A9A5]" fill="currentColor" viewBox="0 0 20 20">
                            <path fill-rule="evenodd" d="M5.05 4.05a7 7 0 119.9 9.9L10 18.9l-4.95-4.95a7 7 0 010-9.9zM10 11a2 2 0 100-4 2 2 0 000 4z" clip-rule="evenodd"></path>
                        </svg>
                        <span class="text-sm text-[#00A9A5] font-medium">À moins de 2 km</span>
                    </div>
                    <h2 class="text-2xl font-bold text-[#4A4A4A]">Événements près de chez vous</h2>
                </div>
                <a href="#" class="text-[#00A9A5] font-semibold hover:underline flex items-center gap-1">
                    Voir sur la carte
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
                    </svg>
                </a>
            </div>
            
            <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-6">
                {% set evenements = [
                    {titre: 'Dégustation de vins & fromages', date: 'Ce soir', heure: '19h00', lieu: 'Le Petit Bistro', distance: '120m', participants: 24, image: '🍷', type: 'Dégustation'},
                    {titre: 'Atelier cuisine italienne', date: 'Demain', heure: '14h00', lieu: 'Cucina Mia', distance: '450m', participants: 12, image: '🍝', type: 'Atelier'},
                    {titre: 'Soirée food truck festival', date: 'Samedi', heure: '18h00', lieu: 'Place de la Mairie', distance: '800m', participants: 156, image: '🚚', type: 'Festival'}
                ] %}
                
                {% for event in evenements %}
                    <div class="bg-white rounded-2xl overflow-hidden shadow-sm hover:shadow-xl transition-all duration-300 border border-gray-100 group">
                        <div class="h-32 bg-gradient-to-br from-[#84DCCF] to-[#00A9A5] flex items-center justify-center relative">
                            <span class="text-6xl">{{ event.image }}</span>
                            <div class="absolute top-3 left-3 bg-white/90 backdrop-blur-sm rounded-lg px-3 py-1">
                                <span class="text-xs font-bold text-[#4A4A4A]">{{ event.type }}</span>
                            </div>
                            <div class="absolute top-3 right-3 bg-[#00A9A5] text-white rounded-lg px-2 py-1 flex items-center gap-1">
                                <svg class="w-3 h-3" fill="currentColor" viewBox="0 0 20 20">
