{% extends 'base.html.twig' %}

{% block title %}Mes favoris - Miam'Up{% endblock %}

{% block body %}

{% set fallback_images = [
    'https://images.unsplash.com/photo-1765276999390-d77d822b3c4b?crop=entropy&cs=tinysrgb&fit=max&fm=jpg&w=400',
    'https://images.unsplash.com/photo-1517248135467-4c7edcad34c4?crop=entropy&cs=tinysrgb&fit=max&fm=jpg&w=400',
    'https://images.unsplash.com/photo-1552566626-52f8b828add9?crop=entropy&cs=tinysrgb&fit=max&fm=jpg&w=400',
    'https://images.unsplash.com/photo-1414235077428-338989a2e8c0?crop=entropy&cs=tinysrgb&fit=max&fm=jpg&w=400',
] %}

<div class="flex h-screen overflow-hidden bg-[#F8F8F8] font-['Inter',sans-serif]">

    {% include 'partials/_sidebar.html.twig' with { active: 'favoris' } %}

    <div class="flex-1 overflow-y-auto">

        {% if favoris|length == 0 %}
            {# ── État vide ── #}
            <div class="flex flex-col items-center justify-center h-full text-center px-4">
                <div class="w-16 h-16 bg-[#FF6B6B]/10 rounded-2xl flex items-center justify-center mb-6">
                    <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none"
                         stroke="#FF6B6B" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M19 14c1.49-1.46 3-3.21 3-5.5A5.5 5.5 0 0 0 16.5 3c-1.76 0-3 .5-4.5 2-1.5-1.5-2.74-2-4.5-2A5.5 5.5 0 0 0 2 8.5c0 2.3 1.5 4.05 3 5.5l7 7Z"/>
                    </svg>
                </div>
                <h2 class="text-xl font-semibold text-[#4A4A4A] mb-2">Vos favoris</h2>
                <p class="text-[#4A4A4A]/60 mb-6 max-w-sm">Vous n'avez pas encore de restaurants favoris. Explorez la carte ou la liste pour en ajouter !</p>
                <a href="{{ path('restaurant_list') }}"
                   class="bg-[#00A9A5] text-white px-6 py-3 rounded-xl hover:bg-[#008F8C] transition-colors font-medium">
                    Explorer les restaurants
                </a>
            </div>
        {% else %}
            {# ── Liste des favoris ── #}
            <div class="p-8">
                <h1 class="text-2xl font-bold text-[#4A4A4A] mb-6">Vos favoris ({{ favoris|length }})</h1>

                <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
                    {% for restaurant in favoris %}
                        {% set img = restaurant.logo ? '/uploads/restaurants/' ~ restaurant.logo : fallback_images[loop.index0 % 4] %}
                        <div class="bg-white rounded-2xl overflow-hidden shadow-sm border border-gray-100 hover:shadow-md transition-shadow">
                            <div class="relative">
                                <img src="{{ img }}" alt="{{ restaurant.nomRestaurant }}" class="w-full h-40 object-cover">
                                <form method="POST" action="{{ path('app_favoris_toggle', {id: restaurant.id}) }}" class="absolute top-3 right-3">
                                    <input type="hidden" name="_token" value="{{ csrf_token('favoris_toggle_' ~ restaurant.id) }}">
                                    <button type="submit" class="w-9 h-9 bg-white/90 backdrop-blur rounded-full flex items-center justify-center hover:bg-white transition-colors shadow-sm">
                                        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24"
                                             fill="#FF6B6B" stroke="#FF6B6B" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                            <path d="M19 14c1.49-1.46 3-3.21 3-5.5A5.5 5.5 0 0 0 16.5 3c-1.76 0-3 .5-4.5 2-1.5-1.5-2.74-2-4.5-2A5.5 5.5 0 0 0 2 8.5c0 2.3 1.5 4.05 3 5.5l7 7Z"/>
                                        </svg>
                                    </button>
                                </form>
                            </div>
                            <div class="p-4">
                                <h3 class="font-semibold text-[#4A4A4A] mb-1">{{ restaurant.nomRestaurant }}</h3>
                                {% if restaurant.adresseRestaurant %}
                                    <p class="text-sm text-[#4A4A4A]/60 mb-2">{{ restaurant.adresseRestaurant }}</p>
                                {% endif %}
                                <div class="flex items-center justify-between">
                                    {% if restaurant.noteConsommateurs %}
                                        <div class="flex items-center gap-1">
                                            <span class="text-amber-400">★</span>
                                            <span class="text-sm font-medium text-[#4A4A4A]">{{ restaurant.noteConsommateurs|number_format(1) }}</span>
                                        </div>
                                    {% endif %}
                                    <a href="{{ path('restaurant_show', {id: restaurant.id}) }}"
                                       class="text-sm text-[#00A9A5] font-medium hover:underline">Voir →</a>
                                </div>
                            </div>
                        </div>
                    {% endfor %}
                </div>
            </div>
        {% endif %}

    </div>
</div>
{% endblock %}
