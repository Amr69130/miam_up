{# Usage: {% include 'partials/_sidebar.html.twig' with { active: 'accueil' } %} #}

{% set nav_items = [
    { key: 'accueil',     label: 'Accueil',     path: 'app_home',        icon: 'home' },
    { key: 'carte',       label: 'Carte',       path: 'app_map',         icon: 'map' },
    { key: 'restaurants', label: 'Restaurants',  path: 'restaurant_list', icon: 'list' },
] %}

<nav class="w-16 bg-white border-r border-[#e5e7eb] flex flex-col items-center py-4 gap-1 flex-shrink-0">

    <div class="w-10 h-10 bg-[#00A9A5] rounded-[14px] flex items-center justify-center mb-6">
        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none"
             stroke="white" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="m16 2-2.3 2.3a3 3 0 0 0 0 4.2l1.8 1.8a3 3 0 0 0 4.2 0L22 8"/>
            <path d="M15 15 3.3 3.3a4.2 4.2 0 0 0 0 6l7.3 7.3c1.7 1.7 4.3 1.7 6 0L15 15Z"/>
            <path d="m2 2 20 20"/>
            <path d="m19.5 8.5-7.3 7.3"/>
        </svg>
    </div>

    {% for item in nav_items %}
        {% set is_active = (active is defined and active == item.key) %}
        <a href="{{ path(item.path) }}"
           class="w-12 h-12 rounded-[14px] flex flex-col items-center justify-center gap-0.5 transition-colors
                  {{ is_active ? 'bg-[#84DCCF]/15 text-[#00A9A5]' : 'text-[#99A1AF] hover:text-[#4A4A4A] hover:bg-gray-50' }}">

            {% if item.icon == 'home' %}
                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none"
                     stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="m3 9 9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/>
                    <polyline points="9 22 9 12 15 12 15 22"/>
                </svg>
            {% elseif item.icon == 'map' %}
                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none"
                     stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M14.106 5.553a2 2 0 0 0 1.788 0l3.659-1.83A1 1 0 0 1 21 4.619v12.764a1 1 0 0 1-.553.894l-4.553 2.277a2 2 0 0 1-1.788 0l-4.212-2.106a2 2 0 0 0-1.788 0l-3.659 1.83A1 1 0 0 1 3 19.381V6.618a1 1 0 0 1 .553-.894l4.553-2.277a2 2 0 0 1 1.788 0z"/>
                    <path d="M15 5.764v15"/><path d="M9 3.236v15"/>
                </svg>
            {% elseif item.icon == 'list' %}
                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none"
                     stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <line x1="8" x2="21" y1="6" y2="6"/><line x1="8" x2="21" y1="12" y2="12"/>
                    <line x1="8" x2="21" y1="18" y2="18"/><line x1="3" x2="3.01" y1="6" y2="6"/>
                    <line x1="3" x2="3.01" y1="12" y2="12"/><line x1="3" x2="3.01" y1="18" y2="18"/>
                </svg>
            {% endif %}

            <span class="text-[9px] leading-[13.5px]">{{ item.label }}</span>
        </a>
    {% endfor %}
</nav>
