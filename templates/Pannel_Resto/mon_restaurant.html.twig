{% extends 'base.html.twig' %}

{% block title %}Mon restaurant – Panneau restaurateur{% endblock %}

{#
  Variables attendues :
    restaurant.nomRestaurant, restaurant.adresseRestaurant, restaurant.siret, restaurant.numTelRestaurant,
    restaurant.siteWeb, restaurant.carteMenu, restaurant.logo,
    restaurant.descriptionRestaurant, restaurant.horaires
#}

{% block body %}

<div class="flex min-h-screen bg-[#F8F8F8]">

  {% include 'pannel_resto/_sidebar.html.twig' with { active: 'monresto' } %}

  <div class="ml-16 flex-1 flex flex-col min-h-screen">

    {% include 'pannel_resto/_header.html.twig' %}
    {% include 'pannel_resto/_tabs_nav.html.twig' with { active_tab: 'restaurant' } %}

    <main class="p-6 max-w-5xl pb-16">

      <div class="mb-6">
        <h2 class="text-xl font-bold text-[#4A4A4A]">Informations générales</h2>
        <p class="text-sm text-gray-500 mt-1">
          Gérez les informations visibles par les consommateurs sur
          <span class="text-[#00A9A5]">votre fiche restaurant</span>.
        </p>
      </div>

      <div class="bg-gray-100 rounded-xl px-4 py-3 text-sm text-gray-500 mb-6">
        Le numéro SIRET est non modifiable. Pour toute correction, contactez le support Miam_Up.
      </div>

      {# Grille 2 colonnes — champs simples #}
      <div class="grid grid-cols-1 md:grid-cols-2 gap-4 mb-4">

        {# Nom du restaurant #}
        <div class="bg-white rounded-xl border border-gray-200 p-4">
          <div class="flex items-center justify-between mb-2">
            <div class="flex items-center gap-1.5 text-xs font-semibold text-gray-400 uppercase tracking-wide">
              <svg xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 10h16M4 14h16M4 18h16"/></svg>
              Nom du restaurant
            </div>
            <button type="button" onclick="openEditModal('nom_restaurant', 'Nom du restaurant', '{{ restaurant.nomRestaurant|e('js') }}')"
                    class="flex items-center gap-1 text-xs text-[#00A9A5] hover:underline">
              <svg xmlns="http://www.w3.org/2000/svg" class="w-3 h-3" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M15.232 5.232l3.536 3.536M9 13l6.586-6.586a2 2 0 112.828 2.828L11.828 15.828a2 2 0 01-1.414.586H9v-1.414A2 2 0 019.586 13z"/></svg>
              Modifier
            </button>
          </div>
          <p class="text-[#4A4A4A] text-sm font-medium">{{ restaurant.nomRestaurant }}</p>
        </div>

        {# Adresse #}
        <div class="bg-white rounded-xl border border-gray-200 p-4">
          <div class="flex items-center justify-between mb-2">
            <div class="flex items-center gap-1.5 text-xs font-semibold text-gray-400 uppercase tracking-wide">
              <svg xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/><path stroke-linecap="round" stroke-linejoin="round" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/></svg>
              Adresse
            </div>
            <button type="button" onclick="openEditModal('adresse_restaurant', 'Adresse', '{{ restaurant.adresseRestaurant|e('js') }}')"
                    class="flex items-center gap-1 text-xs text-[#00A9A5] hover:underline">
              <svg xmlns="http://www.w3.org/2000/svg" class="w-3 h-3" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M15.232 5.232l3.536 3.536M9 13l6.586-6.586a2 2 0 112.828 2.828L11.828 15.828a2 2 0 01-1.414.586H9v-1.414A2 2 0 019.586 13z"/></svg>
              Modifier
            </button>
          </div>
          <p class="text-[#4A4A4A] text-sm font-medium">{{ restaurant.adresseRestaurant }}</p>
        </div>

        {# SIRET (non modifiable) #}
        <div class="bg-white rounded-xl border border-gray-200 p-4">
          <div class="flex items-center gap-1.5 text-xs font-semibold text-gray-400 uppercase tracking-wide mb-2">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2"/></svg>
            SIRET
          </div>
          <p class="text-[#4A4A4A] text-sm font-medium">{{ restaurant.siret }}</p>
        </div>

        {# Téléphone #}
        <div class="bg-white rounded-xl border border-gray-200 p-4">
          <div class="flex items-center justify-between mb-2">
            <div class="flex items-center gap-1.5 text-xs font-semibold text-gray-400 uppercase tracking-wide">
              <svg xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/></svg>
              Numéro de téléphone
            </div>
            <button type="button" onclick="openEditModal('num_tel_restaurant', 'Numéro de téléphone', '{{ restaurant.numTelRestaurant|e('js') }}')"
                    class="flex items-center gap-1 text-xs text-[#00A9A5] hover:underline">
              <svg xmlns="http://www.w3.org/2000/svg" class="w-3 h-3" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M15.232 5.232l3.536 3.536M9 13l6.586-6.586a2 2 0 112.828 2.828L11.828 15.828a2 2 0 01-1.414.586H9v-1.414A2 2 0 019.586 13z"/></svg>
              Modifier
            </button>
          </div>
          <p class="text-[#4A4A4A] text-sm font-medium">{{ restaurant.numTelRestaurant }}</p>
        </div>

        {# Site web #}
        <div class="bg-white rounded-xl border border-gray-200 p-4">
          <div class="flex items-center justify-between mb-2">
            <div class="flex items-center gap-1.5 text-xs font-semibold text-gray-400 uppercase tracking-wide">
              <svg xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M21 12a9 9 0 01-9 9m9-9a9 9 0 00-9-9m9 9H3m9 9a9 9 0 01-9-9m9 9c1.657 0 3-4.03 3-9s-1.343-9-3-9m0 18c-1.657 0-3-4.03-3-9s1.343-9 3-9"/></svg>
              Site web
            </div>
            <button type="button" onclick="openEditModal('site_web', 'Site web', '{{ restaurant.siteWeb|e('js') }}')"
                    class="flex items-center gap-1 text-xs text-[#00A9A5] hover:underline">
              <svg xmlns="http://www.w3.org/2000/svg" class="w-3 h-3" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M15.232 5.232l3.536 3.536M9 13l6.586-6.586a2 2 0 112.828 2.828L11.828 15.828a2 2 0 01-1.414.586H9v-1.414A2 2 0 019.586 13z"/></svg>
              Modifier
            </button>
          </div>
          <p class="text-[#4A4A4A] text-sm font-medium break-all">{{ restaurant.siteWeb }}</p>
        </div>

        {# Lien carte / menu #}
        <div class="bg-white rounded-xl border border-gray-200 p-4">
          <div class="flex items-center justify-between mb-2">
            <div class="flex items-center gap-1.5 text-xs font-semibold text-gray-400 uppercase tracking-wide">
              <svg xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"/></svg>
              Lien carte / menu
            </div>
            <button type="button" onclick="openEditModal('carte_menu', 'Lien carte / menu', '{{ restaurant.carteMenu|e('js') }}')"
                    class="flex items-center gap-1 text-xs text-[#00A9A5] hover:underline">
              <svg xmlns="http://www.w3.org/2000/svg" class="w-3 h-3" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M15.232 5.232l3.536 3.536M9 13l6.586-6.586a2 2 0 112.828 2.828L11.828 15.828a2 2 0 01-1.414.586H9v-1.414A2 2 0 019.586 13z"/></svg>
              Modifier
            </button>
          </div>
          <p class="text-[#4A4A4A] text-sm font-medium break-all">{{ restaurant.carteMenu }}</p>
        </div>

      </div>

      {# URL logo — demi-largeur #}
      <div class="grid grid-cols-1 md:grid-cols-2 gap-4 mb-4">
        <div class="bg-white rounded-xl border border-gray-200 p-4">
          <div class="flex items-center justify-between mb-2">
            <div class="flex items-center gap-1.5 text-xs font-semibold text-gray-400 uppercase tracking-wide">
              <svg xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"/></svg>
              URL du logo
            </div>
            <button type="button" onclick="openEditModal('logo', 'URL du logo', '{{ restaurant.logo|e('js') }}')"
                    class="flex items-center gap-1 text-xs text-[#00A9A5] hover:underline">
              <svg xmlns="http://www.w3.org/2000/svg" class="w-3 h-3" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M15.232 5.232l3.536 3.536M9 13l6.586-6.586a2 2 0 112.828 2.828L11.828 15.828a2 2 0 01-1.414.586H9v-1.414A2 2 0 019.586 13z"/></svg>
              Modifier
            </button>
          </div>
          <p class="text-[#4A4A4A] text-sm font-medium break-all">{{ restaurant.logo }}</p>
        </div>
      </div>

      {# Description — pleine largeur #}
      <div class="mb-4">
        <div class="bg-white rounded-xl border border-gray-200 p-4">
          <div class="flex items-center justify-between mb-2">
            <div class="flex items-center gap-1.5 text-xs font-semibold text-gray-400 uppercase tracking-wide">
              <svg xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h7"/></svg>
              Description
            </div>
            <button type="button" onclick="openEditModalTextarea('description_restaurant', 'Description', '{{ restaurant.descriptionRestaurant|e('js') }}')"
                    class="flex items-center gap-1 text-xs text-[#00A9A5] hover:underline">
              <svg xmlns="http://www.w3.org/2000/svg" class="w-3 h-3" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M15.232 5.232l3.536 3.536M9 13l6.586-6.586a2 2 0 112.828 2.828L11.828 15.828a2 2 0 01-1.414.586H9v-1.414A2 2 0 019.586 13z"/></svg>
              Modifier
            </button>
          </div>
          <p class="text-[#4A4A4A] text-sm font-medium leading-relaxed">{{ restaurant.descriptionRestaurant }}</p>
        </div>
      </div>

      {# Horaires d'ouverture (Modifié pour un affichage texte simple) #}
      <div class="bg-white rounded-xl border border-gray-200 p-4">
        <div class="flex items-center justify-between mb-4">
          <div class="flex items-center gap-1.5 text-xs font-semibold text-gray-400 uppercase tracking-wide">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
            Horaires d'ouverture
          </div>
          <button type="button" onclick="openHorairesModal()"
                  class="flex items-center gap-1 text-xs text-[#00A9A5] hover:underline">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-3 h-3" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M15.232 5.232l3.536 3.536M9 13l6.586-6.586a2 2 0 112.828 2.828L11.828 15.828a2 2 0 01-1.414.586H9v-1.414A2 2 0 019.586 13z"/></svg>
            Modifier
          </button>
        </div>
        <div class="space-y-2">
           <p class="text-[#4A4A4A] text-sm font-medium whitespace-pre-line">{{ restaurant.horaires|default('Horaires non renseignés') }}</p>
        </div>
      </div>

    </main>
  </div>
</div>

{# ===== MODALE — Modifier un champ texte ou textarea ===== #}
<div id="modal-edit" class="hidden fixed inset-0 z-50 flex items-center justify-center bg-black/40 px-4">
  <div class="bg-white rounded-2xl shadow-2xl w-full max-w-md">
    <div class="flex items-center justify-between px-6 pt-6 pb-4 border-b border-gray-100">
      <h3 id="modal-edit-title" class="font-bold text-[#4A4A4A] text-lg">Modifier</h3>
      <button type="button" onclick="closeEditModal()" class="w-8 h-8 flex items-center justify-center rounded-xl hover:bg-gray-100">
        <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-gray-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"/></svg>
      </button>
    </div>
    <form method="POST" action="{{ path('panneau_update_field') }}" class="px-6 py-5">
      <input type="hidden" name="_token" value="{{ csrf_token('update_field') }}">
      <input type="hidden" id="edit-field-key" name="field">
      <div class="mb-4">
        <label id="modal-edit-label" class="block text-xs font-semibold text-gray-500 uppercase tracking-wide mb-1.5">Valeur</label>
        <input id="edit-field-input" name="value" type="text"
               class="w-full border border-gray-200 focus:border-[#00A9A5] rounded-xl px-4 py-2.5 text-sm text-[#4A4A4A] outline-none transition-colors">
        <textarea id="edit-field-textarea" name="value" rows="4"
                  class="hidden w-full border border-gray-200 focus:border-[#00A9A5] rounded-xl px-4 py-2.5 text-sm text-[#4A4A4A] outline-none resize-none transition-colors"></textarea>
      </div>
      <div class="flex items-center justify-end gap-3 pt-2 border-t border-gray-100">
        <button type="button" onclick="closeEditModal()"
                class="px-4 py-2 text-sm font-medium text-[#4A4A4A] border border-gray-200 rounded-xl hover:bg-gray-50">Annuler</button>
        <button type="submit"
                class="flex items-center gap-2 px-5 py-2 text-sm font-semibold text-white bg-[#00A9A5] hover:bg-[#008b87] rounded-xl shadow-sm">
          <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg>
          Enregistrer
        </button>
      </div>
    </form>
  </div>
</div>

{# ===== MODALE — Modifier les horaires ===== #}
<div id="modal-horaires" class="hidden fixed inset-0 z-50 flex items-center justify-center bg-black/40 px-4">
  <div class="bg-white rounded-2xl shadow-2xl w-full max-w-md max-h-[90vh] overflow-y-auto">
    <div class="flex items-center justify-between px-6 pt-6 pb-4 border-b border-gray-100">
      <h3 class="font-bold text-[#4A4A4A] text-lg">Modifier les horaires</h3>
      <button type="button" onclick="closeHorairesModal()" class="w-8 h-8 flex items-center justify-center rounded-xl hover:bg-gray-100">
        <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-gray-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"/></svg>
      </button>
    </div>
    <form method="POST" action="{{ path('panneau_update_horaires') }}" class="px-6 py-5 space-y-3">
      <input type="hidden" name="_token" value="{{ csrf_token('update_horaires') }}">
      
      <div class="flex items-center gap-4">
        <textarea name="horaires" rows="5" class="w-full border border-gray-200 focus:border-[#00A9A5] rounded-xl px-4 py-2.5 text-sm text-[#4A4A4A] outline-none resize-none transition-colors" placeholder="Lundi : Fermé&#10;Mardi : 12h00 - 22h00...">{{ restaurant.horaires }}</textarea>
      </div>

      <div class="flex items-center justify-end gap-3 pt-4 border-t border-gray-100">
        <button type="button" onclick="closeHorairesModal()"
                class="px-4 py-2 text-sm font-medium text-[#4A4A4A] border border-gray-200 rounded-xl hover:bg-gray-50">Annuler</button>
        <button type="submit"
                class="flex items-center gap-2 px-5 py-2 text-sm font-semibold text-white bg-[#00A9A5] hover:bg-[#008b87] rounded-xl shadow-sm">
          <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg>
          Enregistrer
        </button>
      </div>
    </form>
  </div>
</div>

<script>
function openEditModal(key, label, value) {
  document.getElementById('edit-field-key').value = key;
  document.getElementById('modal-edit-title').textContent = 'Modifier : ' + label;
  document.getElementById('modal-edit-label').textContent = label;
  var input    = document.getElementById('edit-field-input');
  var textarea = document.getElementById('edit-field-textarea');
  input.value = value;
  input.name = 'value';
  input.classList.remove('hidden');
  textarea.classList.add('hidden');
  textarea.removeAttribute('name');
  document.getElementById('modal-edit').classList.remove('hidden');
}
function openEditModalTextarea(key, label, value) {
  document.getElementById('edit-field-key').value = key;
  document.getElementById('modal-edit-title').textContent = 'Modifier : ' + label;
  document.getElementById('modal-edit-label').textContent = label;
  var input    = document.getElementById('edit-field-input');
  var textarea = document.getElementById('edit-field-textarea');
  textarea.value = value;
  textarea.name = 'value';
  textarea.classList.remove('hidden');
  input.classList.add('hidden');
  input.removeAttribute('name');
  document.getElementById('modal-edit').classList.remove('hidden');
}
function closeEditModal() {
  document.getElementById('modal-edit').classList.add('hidden');
}
function openHorairesModal() {
  document.getElementById('modal-horaires').classList.remove('hidden');
}
function closeHorairesModal() {
  document.getElementById('modal-horaires').classList.add('hidden');
}
document.querySelectorAll('#modal-edit, #modal-horaires').forEach(function(m) {
  m.addEventListener('click', function(e) { if (e.target === this) this.classList.add('hidden'); });
});
</script>

{% endblock %}