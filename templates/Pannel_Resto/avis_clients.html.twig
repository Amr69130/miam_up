{% extends 'base.html.twig' %}

{% block title %}Avis clients – Panneau restaurateur{% endblock %}

{#
  Variables attendues :
    restaurant          (nom, logo, note, total_avis)
    note_moyenne        float
    distribution        array de { etoiles: int, pourcentage: int }
    avis_list           array de { id, auteur, date, note, commentaire, avatar, reponse }
#}

{% block body %}

<div class="flex min-h-screen bg-[#F8F8F8]">

  {% include 'partials/_sidebar.html.twig' with { active: 'monresto' } %}

  <div class="ml-16 flex-1 flex flex-col min-h-screen">

    {% include 'pannel_resto/_tabs_nav.html.twig' with { active_tab: 'avis' } %}

    <main class="p-6 max-w-3xl">

      <div class="mb-6">
        <h2 class="text-xl font-bold text-[#4A4A4A]">Avis clients</h2>
        <p class="text-sm text-gray-500 mt-1">Consultez ce que vos clients pensent de votre restaurant.</p>
      </div>

      {# Résumé des notes #}
      <div class="bg-white rounded-xl border border-gray-200 p-6 mb-4">
        <div class="flex items-start gap-8">

          <div class="text-center flex-shrink-0">
            <p class="text-5xl font-extrabold text-[#4A4A4A]">{{ note_moyenne }}</p>
            <div class="flex items-center gap-0.5 justify-center mt-1">
              {% for i in 1..5 %}
                <svg xmlns="http://www.w3.org/2000/svg"
                     class="w-4 h-4 {{ i <= note_moyenne|round ? 'fill-yellow-400 text-yellow-400' : 'fill-gray-200 text-gray-200' }}"
                     viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M11.049 2.927c.3-.921 1.603-.921 1.902 0l1.519 4.674a1 1 0 00.95.69h4.915c.969 0 1.371 1.24.588 1.81l-3.976 2.888a1 1 0 00-.363 1.118l1.518 4.674c.3.922-.755 1.688-1.538 1.118l-3.976-2.888a1 1 0 00-1.176 0l-3.976 2.888c-.783.57-1.838-.197-1.538-1.118l1.518-4.674a1 1 0 00-.363-1.118l-3.976-2.888c-.784-.57-.38-1.81.588-1.81h4.914a1 1 0 00.951-.69l1.519-4.674z"/>
                </svg>
              {% endfor %}
            </div>
            <p class="text-xs text-gray-400 mt-1">{{ avis_list|length }} avis</p>
          </div>

          <div class="flex-1 space-y-2">
            {% for row in distribution %}
              <div class="flex items-center gap-3">
                <span class="text-sm text-gray-500 w-3">{{ row.etoiles }}</span>
                <svg xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5 fill-yellow-400 text-yellow-400 flex-shrink-0" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M11.049 2.927c.3-.921 1.603-.921 1.902 0l1.519 4.674a1 1 0 00.95.69h4.915c.969 0 1.371 1.24.588 1.81l-3.976 2.888a1 1 0 00-.363 1.118l1.518 4.674c.3.922-.755 1.688-1.538 1.118l-3.976-2.888a1 1 0 00-1.176 0l-3.976 2.888c-.783.57-1.838-.197-1.538-1.118l1.518-4.674a1 1 0 00-.363-1.118l-3.976-2.888c-.784-.57-.38-1.81.588-1.81h4.914a1 1 0 00.951-.69l1.519-4.674z"/>
                </svg>
                <div class="flex-1 h-2.5 bg-gray-100 rounded-full overflow-hidden">
                  <div class="h-full bg-[#00A9A5] rounded-full" style="width: {{ row.pourcentage }}%"></div>
                </div>
                <span class="text-sm text-gray-400 w-8 text-right">{{ row.pourcentage }}%</span>
              </div>
            {% endfor %}
          </div>

        </div>
      </div>

      {# Liste des avis #}
      <div class="space-y-3">
        {% for avis in avis_list %}
          <div class="bg-white rounded-xl border border-gray-200 p-4">

            <div class="flex items-start justify-between mb-2">
              <div class="flex items-center gap-3">
                <img src="{{ avis.avatar }}" alt="{{ avis.auteur }}" class="w-9 h-9 rounded-full object-cover">
                <div>
                  <p class="font-semibold text-sm text-[#4A4A4A]">{{ avis.auteur }}</p>
                  <p class="text-xs text-gray-400">{{ avis.date }}</p>
                </div>
              </div>
              <div class="flex items-center gap-0.5">
                {% for i in 1..5 %}
                  <svg xmlns="http://www.w3.org/2000/svg"
                       class="w-4 h-4 {{ i <= avis.note ? 'fill-yellow-400 text-yellow-400' : 'fill-gray-200 text-gray-200' }}"
                       viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M11.049 2.927c.3-.921 1.603-.921 1.902 0l1.519 4.674a1 1 0 00.95.69h4.915c.969 0 1.371 1.24.588 1.81l-3.976 2.888a1 1 0 00-.363 1.118l1.518 4.674c.3.922-.755 1.688-1.538 1.118l-3.976-2.888a1 1 0 00-1.176 0l-3.976 2.888c-.783.57-1.838-.197-1.538-1.118l1.518-4.674a1 1 0 00-.363-1.118l-3.976-2.888c-.784-.57-.38-1.81.588-1.81h4.914a1 1 0 00.951-.69l1.519-4.674z"/>
                  </svg>
                {% endfor %}
              </div>
            </div>

            <p class="text-sm text-[#4A4A4A] leading-relaxed mb-3">{{ avis.commentaire }}</p>

            {% if avis.reponse %}
              <div class="bg-[#E6F7F7] rounded-lg px-4 py-3 mb-3 border-l-4 border-[#00A9A5]">
                <p class="text-xs font-semibold text-[#00A9A5] mb-1">Votre réponse</p>
                <p class="text-sm text-[#4A4A4A]">{{ avis.reponse }}</p>
              </div>
            {% endif %}

            <button type="button"
                    onclick="toggleReply('reply-{{ avis.id }}')"
                    class="flex items-center gap-1.5 text-xs text-[#00A9A5] hover:underline font-medium">
              <svg xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z"/></svg>
              {{ avis.reponse ? 'Modifier la réponse' : 'Répondre à cet avis' }}
              <svg id="chevron-{{ avis.id }}" xmlns="http://www.w3.org/2000/svg" class="w-3 h-3 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"/></svg>
            </button>

            <div id="reply-{{ avis.id }}" class="hidden mt-3">
              <form method="POST" action="{{ path('panneau_repondre_avis', { id: avis.id }) }}">
                <input type="hidden" name="_token" value="{{ csrf_token('repondre_avis_' ~ avis.id) }}">
                <textarea name="reponse" rows="3"
                          placeholder="Rédigez votre réponse au client..."
                          class="w-full border border-gray-200 focus:border-[#00A9A5] rounded-xl px-4 py-2.5 text-sm text-[#4A4A4A] outline-none resize-none placeholder-gray-300 transition-colors">{{ avis.reponse }}</textarea>
                <div class="flex items-center justify-end gap-2 mt-2">
                  <button type="button" onclick="toggleReply('reply-{{ avis.id }}')"
                          class="text-xs text-gray-400 hover:text-gray-600 px-3 py-1.5">Annuler</button>
                  <button type="submit"
                          class="flex items-center gap-1.5 text-xs font-semibold text-white bg-[#00A9A5] hover:bg-[#008b87] px-4 py-1.5 rounded-xl transition-colors">
                    <svg xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M12 19l9 2-9-18-9 18 9-2zm0 0v-8"/></svg>
                    Publier la réponse
                  </button>
                </div>
              </form>
            </div>

          </div>
        {% endfor %}
      </div>

    </main>
  </div>
</div>

<script>
function toggleReply(id) {
  var zone = document.getElementById(id);
  var isHidden = zone.classList.contains('hidden');
  zone.classList.toggle('hidden');
  var avisId = id.replace('reply-', '');
  var chevron = document.getElementById('chevron-' + avisId);
  if (chevron) chevron.style.transform = isHidden ? 'rotate(180deg)' : 'rotate(0deg)';
}
</script>

{% endblock %}
