{% extends 'base.html.twig' %}

{% block title %}Événements – Panneau restaurateur{% endblock %}

{#
  Variables attendues :
    restaurant    (nom, logo, note, total_avis)
    evenements    array de { id, titre, date_evenement, heure_debut, heure_fin,
                             participants, nombre_places, description_evenement,
                             image, restaurant_id }
#}

{% block body %}

<div class="flex min-h-screen bg-[#F8F8F8]">

  {% include 'partials/_sidebar.html.twig' with { active: 'monresto' } %}

  <div class="ml-16 flex-1 flex flex-col min-h-screen">

    {% include 'pannel_resto/_tabs_nav.html.twig' with { active_tab: 'evenements' } %}

    <main class="p-6 max-w-3xl">

      <div class="flex items-start justify-between mb-2">
        <div>
          <h2 class="text-xl font-bold text-[#4A4A4A]">Événements</h2>
          <p class="text-sm text-gray-500 mt-1">Créez et gérez les événements organisés dans votre restaurant.</p>
        </div>
        <button type="button"
                onclick="openEvenementModal()"
                class="flex items-center gap-2 bg-[#00A9A5] hover:bg-[#008b87] text-white px-4 py-2.5 rounded-xl text-sm font-semibold transition-colors shadow-sm flex-shrink-0">
          <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M12 4v16m8-8H4"/></svg>
          Créer un événement
        </button>
      </div>

      <div class="space-y-4 mt-6">

        {% if evenements is empty %}
          <div class="bg-white rounded-xl border border-dashed border-gray-200 px-6 py-10 text-center">
            <p class="text-sm text-gray-400">Aucun événement pour l'instant.</p>
          </div>
        {% endif %}

        {% for evt in evenements %}
          {% set nb_participants = evt.utilisateurs|length %}
          {% set places_restantes = evt.nombrePlaces ? evt.nombrePlaces - nb_participants : 0 %}
          {% set is_past = evt.dateEvenement < date() %}
          <div class="bg-white rounded-xl border border-gray-200 overflow-hidden{{ is_past ? ' opacity-60' : '' }}">
            <div class="flex gap-4 p-4">

              {% if false %}{# pas de champ image sur Evenement #}
                <div class="w-28 h-24 rounded-lg overflow-hidden flex-shrink-0">
                  <img src="{{ evt.image }}" alt="{{ evt.titre }}" class="w-full h-full object-cover">
                </div>
              {% endif %}

              <div class="flex-1 min-w-0">
                <div class="flex items-center gap-2 mb-1.5">
                  <h3 class="font-semibold text-[#4A4A4A] text-base">{{ evt.titre }}</h3>
                  {% if is_past %}
                    <span class="text-[10px] font-semibold uppercase tracking-wide text-white bg-gray-400 px-2 py-0.5 rounded-full">Passé</span>
                  {% endif %}
                </div>
                <div class="flex flex-wrap items-center gap-3 text-xs text-gray-500 mb-2">
                  <span class="flex items-center gap-1">
                    <svg xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5 text-[#00A9A5]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/></svg>
                    {% set mois_fr = { '01':'janvier','02':'février','03':'mars','04':'avril','05':'mai','06':'juin','07':'juillet','08':'août','09':'septembre','10':'octobre','11':'novembre','12':'décembre' } %}
                    {{ evt.dateEvenement|date('d') }} {{ mois_fr[evt.dateEvenement|date('m')] }} {{ evt.dateEvenement|date('Y') }} à {{ evt.dateEvenement|date('H:i') }}
                  </span>
                  <span class="flex items-center gap-1">
                    <svg xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5 text-[#00A9A5]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M17 20h5v-2a4 4 0 00-5-3.5M9 20H4v-2a4 4 0 015-3.5m5-5a4 4 0 100-8 4 4 0 000 8zm-8 4a3 3 0 110-6 3 3 0 010 6z"/></svg>
                    {{ nb_participants }}/{{ evt.nombrePlaces ?? '∞' }} places
                  </span>
                </div>
                {% if evt.descriptionEvenement %}
                  <p class="text-sm text-gray-500 leading-relaxed line-clamp-2">{{ evt.descriptionEvenement }}</p>
                {% endif %}
              </div>
            </div>

            <div class="border-t border-gray-100 px-4 py-3 flex items-center gap-3">
              {% if not is_past %}
              <button type="button"
                      onclick="openEvenementModal({
                        id: {{ evt.id }},
                        titre: '{{ evt.titre|e('js') }}',
                        date: '{{ evt.dateEvenement|date('Y-m-d') }}',
                        heure: '{{ evt.dateEvenement|date('H:i') }}',
                        nombrePlaces: {{ evt.nombrePlaces ?? 0 }},
                        minPlaces: {{ nb_participants }},
                        description: '{{ evt.descriptionEvenement|e('js') }}'
                      })"
                      class="flex items-center gap-1.5 text-xs text-[#4A4A4A] hover:text-[#00A9A5] border border-gray-200 hover:border-[#00A9A5] px-3 py-1.5 rounded-lg transition-colors">
                <svg xmlns="http://www.w3.org/2000/svg" class="w-3 h-3" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M15.232 5.232l3.536 3.536M9 13l6.586-6.586a2 2 0 112.828 2.828L11.828 15.828a2 2 0 01-1.414.586H9v-1.414A2 2 0 019.586 13z"/></svg>
                Modifier
              </button>
              {% endif %}
              <button type="button"
                      onclick="openConfirmSuppr({{ evt.id }}, '{{ evt.titre|e('js') }}')"
                      class="flex items-center gap-1.5 text-xs text-[#FF6B6B] hover:text-white hover:bg-[#FF6B6B] border border-[#FF6B6B]/40 hover:border-[#FF6B6B] px-3 py-1.5 rounded-lg transition-colors">
                <svg xmlns="http://www.w3.org/2000/svg" class="w-3 h-3" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/></svg>
                Supprimer
              </button>
            </div>
          </div>
        {% endfor %}

      </div>
    </main>
  </div>
</div>

{# ===== MODALE — Créer / Modifier un événement ===== #}
<div id="modal-evenement" class="hidden fixed inset-0 z-50 flex items-center justify-center bg-black/40 px-4">
  <div class="bg-white rounded-2xl shadow-2xl w-full max-w-lg max-h-[90vh] overflow-y-auto">
    <div class="flex items-center justify-between px-6 pt-6 pb-4 border-b border-gray-100">
      <h3 id="modal-evt-title" class="font-bold text-[#4A4A4A] text-lg">Créer un événement</h3>
      <button type="button" onclick="closeEvenementModal()" class="w-8 h-8 flex items-center justify-center rounded-xl hover:bg-gray-100">
        <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-gray-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"/></svg>
      </button>
    </div>
    <form id="form-evenement" method="POST" action="{{ path('panneau_evenement_create') }}" class="px-6 py-5 space-y-4">
      <input type="hidden" name="_token" id="evt-token" value="{{ csrf_token('evenement_create') }}">
      <input type="hidden" name="_method" id="evt-method" value="POST">
      <input type="hidden" name="id" id="evt-id" value="">

      <div>
        <label class="block text-xs font-semibold text-gray-500 uppercase tracking-wide mb-1.5">
          Titre de l'événement <span class="text-[#FF6B6B]">*</span>
        </label>
        <input id="evt-titre" name="titre" type="text" required
               placeholder="Ex : Soirée Dégustation Vins & Fromages"
               class="w-full border border-gray-200 focus:border-[#00A9A5] rounded-xl px-4 py-2.5 text-sm text-[#4A4A4A] outline-none transition-colors placeholder-gray-300">
      </div>

      <div class="grid grid-cols-2 gap-3">
        <div>
          <label class="block text-xs font-semibold text-gray-500 uppercase tracking-wide mb-1.5">
            Date <span class="text-[#FF6B6B]">*</span>
          </label>
          <input id="evt-date" name="date_part" type="date" required
                 min="{{ 'now'|date('Y-m-d') }}"
                 class="w-full border border-gray-200 focus:border-[#00A9A5] rounded-xl px-3 py-2.5 text-sm text-[#4A4A4A] outline-none transition-colors">
          <p id="evt-date-hint" class="hidden text-[11px] text-[#FF6B6B] mt-1">⚠️ Impossible de mettre une date passée. Supprimez l'événement si besoin.</p>
        </div>
        <div>
          <label class="block text-xs font-semibold text-gray-500 uppercase tracking-wide mb-1.5">
            Heure <span class="text-[#FF6B6B]">*</span>
          </label>
          <input id="evt-heure" name="heure_part" type="time" required
                 class="w-full border border-gray-200 focus:border-[#00A9A5] rounded-xl px-3 py-2.5 text-sm text-[#4A4A4A] outline-none transition-colors">
        </div>
      </div>
      {# Champ caché qui sera rempli par le JS avec date+heure combinés #}
      <input type="hidden" id="evt-datetime-combined" name="date_evenement" value="">

      <div>
        <label class="block text-xs font-semibold text-gray-500 uppercase tracking-wide mb-1.5">
          Nombre de places <span class="text-[#FF6B6B]">*</span>
        </label>
        <input id="evt-places" name="nombre_places" type="number" min="1" required
               placeholder="20"
               class="w-full border border-gray-200 focus:border-[#00A9A5] rounded-xl px-4 py-2.5 text-sm text-[#4A4A4A] outline-none transition-colors placeholder-gray-300">
      </div>

      <div>
        <label class="block text-xs font-semibold text-gray-500 uppercase tracking-wide mb-1.5">Description</label>
        <textarea id="evt-description" name="description_evenement" rows="3"
                  placeholder="Décrivez votre événement..."
                  class="w-full border border-gray-200 focus:border-[#00A9A5] rounded-xl px-4 py-2.5 text-sm text-[#4A4A4A] outline-none resize-none transition-colors placeholder-gray-300"></textarea>
      </div>

      <p class="text-xs text-gray-400">Les champs marqués <span class="text-[#FF6B6B]">*</span> sont obligatoires.</p>

      <div class="flex items-center justify-end gap-3 pt-2 border-t border-gray-100">
        <button type="button" onclick="closeEvenementModal()"
                class="px-4 py-2 text-sm font-medium text-[#4A4A4A] border border-gray-200 rounded-xl hover:bg-gray-50">Annuler</button>
        <button type="submit"
                class="flex items-center gap-2 px-5 py-2 text-sm font-semibold text-white bg-[#00A9A5] hover:bg-[#008b87] rounded-xl shadow-sm">
          <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg>
          <span id="evt-submit-label">Créer l'événement</span>
        </button>
      </div>
    </form>
  </div>
</div>

{# ===== MODALE — Confirmation de suppression ===== #}
<div id="modal-confirm-suppr" class="hidden fixed inset-0 z-50 flex items-center justify-center bg-black/40 px-4">
  <div class="bg-white rounded-2xl shadow-2xl w-full max-w-sm p-6">
    <div class="flex items-start gap-3 mb-5">
      <div class="w-10 h-10 rounded-xl bg-red-50 flex items-center justify-center flex-shrink-0">
        <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 text-[#FF6B6B]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M12 9v2m0 4h.01M10.29 3.86L1.82 18a2 2 0 001.71 3h16.94a2 2 0 001.71-3L13.71 3.86a2 2 0 00-3.42 0z"/></svg>
      </div>
      <div>
        <h3 class="font-bold text-[#4A4A4A] mb-1">Supprimer l'événement</h3>
        <p class="text-sm text-gray-500">
          Voulez-vous vraiment supprimer <span id="suppr-titre" class="font-semibold text-[#4A4A4A]"></span> ?
          Cette action est irréversible.
        </p>
      </div>
    </div>
    <form id="form-suppr" method="POST" action="">
      <input type="hidden" name="_token" value="{{ csrf_token('evenement_delete') }}">
      <input type="hidden" name="_method" value="DELETE">
      <div class="flex items-center justify-end gap-3">
        <button type="button" onclick="closeConfirmSuppr()"
                class="px-4 py-2 text-sm font-medium text-[#4A4A4A] border border-gray-200 rounded-xl hover:bg-gray-50">Annuler</button>
        <button type="submit"
                class="px-4 py-2 text-sm font-semibold text-white bg-[#FF6B6B] hover:bg-red-500 rounded-xl">
          Oui, supprimer
        </button>
      </div>
    </form>
  </div>
</div>

<script>
var createUrl  = '{{ path('panneau_evenement_create') }}';
var updateBase = '{{ path('panneau_evenement_update', { id: 0 }) }}'.replace('/0', '/');

function openEvenementModal(data) {
  var isEdit = !!data;
  document.getElementById('modal-evt-title').textContent  = isEdit ? "Modifier l'événement" : 'Créer un événement';
  document.getElementById('evt-submit-label').textContent = isEdit ? 'Enregistrer les modifications' : "Créer l'événement";
  document.getElementById('evt-titre').value       = isEdit ? data.titre        : '';
  document.getElementById('evt-date').value        = isEdit ? data.date         : '';
  document.getElementById('evt-heure').value       = isEdit ? data.heure        : '';
  document.getElementById('evt-places').value      = isEdit ? data.nombrePlaces : '';
  document.getElementById('evt-description').value = isEdit ? data.description  : '';
  document.getElementById('evt-id').value          = isEdit ? data.id           : '';

  // Empêcher de réduire les places en dessous du nombre de participants actuels
  var placesInput = document.getElementById('evt-places');
  if (isEdit && data.minPlaces > 0) {
    placesInput.min = data.minPlaces;
    placesInput.title = 'Minimum ' + data.minPlaces + ' (participants actuels)';
  } else {
    placesInput.min = 1;
    placesInput.title = '';
  }

  var form = document.getElementById('form-evenement');
  if (isEdit) {
    form.action = updateBase + data.id;
    document.getElementById('evt-method').value = 'PUT';
  } else {
    form.action = createUrl;
    document.getElementById('evt-method').value = 'POST';
  }
  document.getElementById('modal-evenement').classList.remove('hidden');
}
function closeEvenementModal() {
  document.getElementById('modal-evenement').classList.add('hidden');
}
function openConfirmSuppr(id, titre) {
  document.getElementById('suppr-titre').textContent = '"' + titre + '"';
  document.getElementById('form-suppr').action = updateBase + id;
  document.getElementById('modal-confirm-suppr').classList.remove('hidden');
}
function closeConfirmSuppr() {
  document.getElementById('modal-confirm-suppr').classList.add('hidden');
}
['modal-evenement', 'modal-confirm-suppr'].forEach(function(id) {
  document.getElementById(id).addEventListener('click', function(e) {
    if (e.target === this) this.classList.add('hidden');
  });
});

// Validation côté client : date + places
(function() {
  var dateInput = document.getElementById('evt-date');
  var dateHint = document.getElementById('evt-date-hint');
  var today = new Date().toISOString().split('T')[0];

  // Afficher le hint en temps réel si date passée
  dateInput.addEventListener('change', function() {
    if (this.value && this.value < today) {
      dateHint.classList.remove('hidden');
      this.classList.add('border-[#FF6B6B]');
      this.classList.remove('border-gray-200');
    } else {
      dateHint.classList.add('hidden');
      this.classList.remove('border-[#FF6B6B]');
      this.classList.add('border-gray-200');
    }
  });

  document.getElementById('form-evenement').addEventListener('submit', function(e) {
    // Validation date
    if (dateInput.value && dateInput.value < today) {
      e.preventDefault();
      dateHint.classList.remove('hidden');
      dateInput.classList.add('border-[#FF6B6B]');
      dateInput.focus();
      return;
    }

    // Validation places
    var placesInput = document.getElementById('evt-places');
    var minPlaces = parseInt(placesInput.min) || 1;
    var value = parseInt(placesInput.value) || 0;
    if (value > 0 && value < minPlaces) {
      e.preventDefault();
      alert('Impossible : il y a déjà ' + minPlaces + ' participant(s) inscrit(s). Le nombre de places ne peut pas être inférieur.');
      placesInput.value = minPlaces;
      placesInput.focus();
      return;
    }

    // Combiner date + heure dans le champ caché avant envoi
    var heureInput = document.getElementById('evt-heure');
    var combined = dateInput.value;
    if (heureInput.value) {
      combined += ' ' + heureInput.value;
    }
    document.getElementById('evt-datetime-combined').value = combined;
  });
})();
</script>

{% endblock %}
