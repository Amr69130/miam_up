{% set restaurant = {
    nom: "Le Petit Bistro",
    logo: "https://images.unsplash.com/photo-1514933651103-005eec06c04b?w=150&q=80",
    note: "4.8",
    total_avis: "124 avis"
} %}
{#
  Header du panneau restaurateur.
  Variables attendues : restaurant.nom, restaurant.logo, restaurant.note, restaurant.total_avis
#}

<div class="bg-white border-b border-gray-200 px-6 py-4 flex items-center justify-between">

  <div class="flex items-center gap-3">
    <div class="w-12 h-12 rounded-full overflow-hidden border-2 border-gray-200 flex-shrink-0">
      <img src="{{ restaurant.logo }}" alt="{{ restaurant.nom }}" class="w-full h-full object-cover">
    </div>
    <div>
      <h1 class="font-bold text-[#4A4A4A] text-lg leading-tight">{{ restaurant.nom }}</h1>
      <p class="text-sm text-gray-500">Panneau restaurateur</p>
    </div>
  </div>

  <div class="flex items-center gap-1.5 bg-[#00A9A5] text-white px-4 py-2 rounded-full text-sm font-bold">
    <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 fill-yellow-300 text-yellow-300" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
      <path stroke-linecap="round" stroke-linejoin="round" d="M11.049 2.927c.3-.921 1.603-.921 1.902 0l1.519 4.674a1 1 0 00.95.69h4.915c.969 0 1.371 1.24.588 1.81l-3.976 2.888a1 1 0 00-.363 1.118l1.518 4.674c.3.922-.755 1.688-1.538 1.118l-3.976-2.888a1 1 0 00-1.176 0l-3.976 2.888c-.783.57-1.838-.197-1.538-1.118l1.518-4.674a1 1 0 00-.363-1.118l-3.976-2.888c-.784-.57-.38-1.81.588-1.81h4.914a1 1 0 00.951-.69l1.519-4.674z"/>
    </svg>
    <span>{{ restaurant.note }} / {{ restaurant.total_avis }}</span>
  </div>

</div>
