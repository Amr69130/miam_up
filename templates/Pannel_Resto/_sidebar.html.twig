{#
  Sidebar partagée — inclure dans n'importe quelle page :
    {% include 'pannel_resto/_sidebar.html.twig' with { active: 'monresto' } %}

  Valeurs possibles pour `active` :
    accueil | carte | restaurants | favoris | membres | monresto
#}

<aside class="fixed left-0 top-0 h-full w-16 bg-white border-r border-gray-100 flex flex-col items-center py-4 z-40">

  {# Logo #}
  <div class="w-10 h-10 bg-[#00A9A5] rounded-xl flex items-center justify-center mb-6 flex-shrink-0">
    <span class="text-white font-extrabold text-lg select-none">M</span>
  </div>

  <nav class="flex flex-col items-center gap-1 flex-1 w-full px-2">

    {# Accueil #}
    {% set is_active = (active is defined and active == 'accueil') %}
    <a href="/" class="flex flex-col items-center gap-1 w-full px-1 py-2 rounded-xl transition-colors {{ is_active ? 'bg-[#E6F7F7] text-[#00A9A5]' : 'text-gray-400 hover:bg-gray-50 hover:text-[#00A9A5]' }}">
      <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M3 12L12 3l9 9M4 10v10a1 1 0 001 1h5v-6h4v6h5a1 1 0 001-1V10"/>
      </svg>
      <span class="text-[9px] font-medium leading-none">Accueil</span>
    </a>

    {# Carte #}
    {% set is_active = (active is defined and active == 'carte') %}
    <a href="/carte" class="flex flex-col items-center gap-1 w-full px-1 py-2 rounded-xl transition-colors {{ is_active ? 'bg-[#E6F7F7] text-[#00A9A5]' : 'text-gray-400 hover:bg-gray-50 hover:text-[#00A9A5]' }}">
      <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M9 20l-5.447-2.724A1 1 0 013 16.382V5.618a1 1 0 011.447-.894L9 7m0 13l6-3m-6 3V7m6 10l4.553 2.276A1 1 0 0021 18.382V7.618a1 1 0 00-.553-.894L15 4m0 13V4m0 0L9 7"/>
      </svg>
      <span class="text-[9px] font-medium leading-none">Carte</span>
    </a>

    {# Restaurants #}
    {% set is_active = (active is defined and active == 'restaurants') %}
    <a href="/restaurants" class="flex flex-col items-center gap-1 w-full px-1 py-2 rounded-xl transition-colors {{ is_active ? 'bg-[#E6F7F7] text-[#00A9A5]' : 'text-gray-400 hover:bg-gray-50 hover:text-[#00A9A5]' }}">
      <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16"/>
      </svg>
      <span class="text-[9px] font-medium leading-none">Restaurants</span>
    </a>

    {# Favoris #}
    {% set is_active = (active is defined and active == 'favoris') %}
    <a href="/favoris" class="flex flex-col items-center gap-1 w-full px-1 py-2 rounded-xl transition-colors {{ is_active ? 'bg-[#E6F7F7] text-[#00A9A5]' : 'text-gray-400 hover:bg-gray-50 hover:text-[#00A9A5]' }}">
      <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M4.318 6.318a4.5 4.5 0 016.364 0L12 7.636l1.318-1.318a4.5 4.5 0 116.364 6.364L12 20.364l-7.682-7.682a4.5 4.5 0 010-6.364z"/>
      </svg>
      <span class="text-[9px] font-medium leading-none">Favoris</span>
    </a>

    {# Membres #}
    {% set is_active = (active is defined and active == 'membres') %}
    <a href="/membres" class="flex flex-col items-center gap-1 w-full px-1 py-2 rounded-xl transition-colors {{ is_active ? 'bg-[#E6F7F7] text-[#00A9A5]' : 'text-gray-400 hover:bg-gray-50 hover:text-[#00A9A5]' }}">
      <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M17 20h5v-2a4 4 0 00-5-3.5M9 20H4v-2a4 4 0 015-3.5m5-5a4 4 0 100-8 4 4 0 000 8zm-8 4a3 3 0 110-6 3 3 0 010 6z"/>
      </svg>
      <span class="text-[9px] font-medium leading-none">Membres</span>
    </a>

    {# MonResto #}
    {% set is_active = (active is defined and active == 'monresto') %}
    <a href="/panneau" class="flex flex-col items-center gap-1 w-full px-1 py-2 rounded-xl transition-colors {{ is_active ? 'bg-[#E6F7F7] text-[#00A9A5]' : 'text-gray-400 hover:bg-gray-50 hover:text-[#00A9A5]' }}">
      <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M3 9.5L12 3l9 6.5V20a1 1 0 01-1 1H4a1 1 0 01-1-1V9.5z"/>
        <path stroke-linecap="round" stroke-linejoin="round" d="M9 21V12h6v9"/>
      </svg>
      <span class="text-[9px] font-medium leading-none">MonResto</span>
    </a>

  </nav>
</aside>
