{% extends 'base.html.twig' %}

{% block title %}Mon Restaurant - Tableau de bord{% endblock %}

{# On masque le header/footer global s'il y en a un dans base.html.twig pour avoir un vrai rendu "Dashboard" #}
{% block body %}
<div class="flex h-screen bg-[#F8F8F8]">
    
    {# 1. On inclut ta fameuse barre latérale #}
    {% include 'pannel_resto/_sidebar.html.twig' with { active: active } %}

    {# 2. Zone principale (qui prend le reste de l'écran) #}
    <div class="flex-1 ml-16 overflow-y-auto">
        
        <main class="min-h-screen">
            {# 3. On inclut le fichier des événements qu'on a traduit tout à l'heure #}
            {% include 'pannel_resto/evenements.html.twig' %}
        </main>
        
    </div>
</div>
{% endblock %}